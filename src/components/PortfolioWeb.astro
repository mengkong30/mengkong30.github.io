otes p{white-space:pre-line;line-height:1.95;color:#64707e;margin:18px 0;overflow-wrap:anywhere}.board-notes[open] summary span{rotate:45deg}.back-index{display:block;width:fit-content;margin:45px auto 0;color:#727b89;font-size:12px}.portfolio-end{text-align:center;padding:90px 0}.portfolio-end h2{font-size:clamp(28px,3.6vw,44px)}.portfolio-end>p:not(.eyebrow){font-size:12px;color:#7f8793;line-height:1.8;margin:25px 0}.portfolio-end>a{display:inline-block;border:1px solid #bdc5cc;border-radius:30px;padding:13px 22px;font-size:13px;color:#242c3d}.artwork-viewer{border:0;padding:0;width:94vw;max-width:1600px;height:92dvh;max-height:92dvh;background:#f6f7f9;color:#242c3d;border-radius:16px;overflow:hidden}.artwork-viewer[open]{display:flex;flex-direction:column}.artwork-viewer::backdrop{background:#0e1427b8;backdrop-filter:blur(7px)}.artwork-viewer header{display:flex;justify-content:space-between;align-items:center;padding:16px 22px;gap:15px}.artwork-viewer h2{font-size:14px;letter-spacing:0}.viewer-close{flex-shrink:0;cursor:pointer;background:#e4e7ed;border:0;border-radius:30px;padding:9px 16px;color:#242c3d}.viewer-body{overflow:auto;flex:1;min-height:0}.viewer-body img{display:block;width:auto;max-width:100%;height:auto;margin:0 auto}.artwork-viewer>p{font-size:10px;text-align:center;color:#727b89;padding:10px;margin:0}.reveal{opacity:0;translate:0 24px;transition:opacity .65s,translate .65s}.reveal.visible{opacity:1;translate:0 0}a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid var(--accent,#758aa4);outline-offset:5px}@media(max-width:850px){.shell{width:calc(100% - 40px)}.hero-collage{grid-template-columns:1fr 1fr}.hero-collage a:first-child{grid-column:1/-1}.hero-collage img{height:190px}.hero-collage a:first-child img{height:auto}.overview{gap:25px}.work-index .shell{gap:14px}.work-index a{font-size:10px;gap:6px}.insights{gap:20px}}@media(max-width:600px){.portfolio-hero{padding-top:25px;padding-bottom:40px}.hero-meta{margin-top:42p