.image-status{text-align:center;font-size:14px;padding:32px;color:var(--muted)}.image-retry{display:block;margin:0 auto}.image-retry[hidden],.image-status[hidden],.viewer-body img[hidden]{display:none}
@media(max-width:850px){.hero-collage a:first-child{grid-column:auto}.project-thumbnail{height:210px}.hero-heading{align-items:start}.hero-heading>p{max-width:220px}.hero-collage .project-thumbnail img{height:100%}.hero-collage .music img{height:88%}}
@media(max-width:640px){.hero-heading{display:block}.hero-heading>p{margin-top:22px;max-width:none;font-size:13px}.hero-collage{grid-template-columns:1fr;gap:22px}.project-thumbnail{height:220px}.overview{grid-template-columns:1fr;gap:20px}.insights{grid-template-columns:1fr;gap:22px}.insights article{display:grid;grid-template-columns:24px 1fr;gap:8px}.insights h4{margin:0}.insights p{grid-column:2}.work-section{padding:40px 0}.portfolio-hero{padding:20px 0 36px}.hero-meta{margin-top:25px}.entry-caption h3{font-size:15px}}
