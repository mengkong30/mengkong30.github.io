<style>
.portfolio-web{--ink:#252b30;--muted:#68717a;--line:#dce0df;background:#fafaf7;color:var(--ink)}
.portfolio-web .shell{max-width:1240px}.portfolio-hero{padding:30px 0 56px}
.hero-meta{margin:36px 0 22px}.hero-heading{display:flex;justify-content:space-between;align-items:end;gap:40px;margin-bottom:36px}
h1{font-size:clamp(32px,4vw,58px);line-height:1.35;font-weight:550;letter-spacing:-.045em}h1 span{color:#727b78}.hero-heading>p{font-size:14px;line-height:1.9;color:var(--muted);margin:0}
.index-heading{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);padding:22px 0}.index-heading h2{font-size:14px;letter-spacing:0;font-weight:500}.index-heading>span{font-size:11px;color:var(--muted)}
.hero-collage{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 24px}.hero-collage a{background:transparent;border-radius:0;overflow:visible}
