.project-thumbnail.ceramics{background:#e9e5dc;padding:22px}.project-thumbnail.experiments{padding:18px;background:#e9edef}
.entry-caption{display:flex;gap:14px;padding:16px 0;border-bottom:1px solid var(--line);align-items:baseline}.entry-caption>small{font-size:10px;color:var(--muted)}.entry-caption h3{font-size:16px;font-weight:550;line-height:1.5;margin:0}.entry-caption p{font-size:11px;color:var(--muted);margin:7px 0 0}.entry-caption b{font-size:20px;font-weight:400;margin-left:auto}
.work-section{padding:60px 0;border-top:1px solid var(--line)}.work-section:nth-of-type(even){background:transparent}
.work-header>h2{font-size:clamp(28px,3.2vw,44px);font-weight:550;line-height:1.4}
