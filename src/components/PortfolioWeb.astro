---
import frames from '../data/portfolio-figma.json';
import PortfolioCaseContent from './PortfolioCaseContent.astro';
const asset=(key:string)=>`/assets/projects/portfolio-web/${key}.webp`;
const projects=[
 {id:'commerce',no:'01',match:'作品1-',title:'让跨境采购，清晰而高效。',name:'HuePure · 海外电商批发平台',en:'COMMERCE / WEB',color:'#d94839',cover:'49-162',intro:'面向东南亚、日韩与美国的跨境 B2B 服装采购场景，以区域仓库适配与采购效率为核心，将找货、查看、批量下单和订单管理连接起来。',tags:['跨境 B2B','信息架构','采购流程'],insights:[['从业务开始','围绕批发商与零售商高效找货、明确成本、把控风险的需求，梳理筛选、查看、下单、物流与售后链路。'],['让决策信息先出现','库存、发货仓、起订量与价格前置，结合清晰分类和商品信息层级，减少反复查找。'],['保持体系一致','以色彩、字体、按钮、输入框和卡片规范建立统一界面语言，兼顾区域适配与不同终端。']]},
 {id:'music',no:'02',match:'作品2-',title:'发现一首歌，也发现一种心情。',name:'乐彩 · 音乐 App',en:'MUSIC / MOBILE',color:'#8253d7',cover:'105-595',intro:'以年轻用户为核心，围绕发现、播放、分享三大场景构建音乐体验。将品牌视觉、沉浸播放与音乐社区结合，让内容发现和日常听歌保持连续。',tags:['18–30 岁目标用户','沉浸播放','音乐社区'],insights:[['理解使用情境','围绕学习、通勤与工作等场景展开用户分析，关注内容新鲜感、搜索分类、收藏管理和播放连续性。'],['三个核心体验','高效发现音乐、沉浸式播放与社区分享相互衔接，配合个人音乐资产管理，构建完整使用路径。'],['统一而有辨识度','渐变色彩建立年轻化视觉氛围，卡片组织推荐内容；Mini Player 为跨页面播放提供连续入口。']]},
 {id:'ceramics',no:'03',match:'作品3-',title:'把瓷器之美，变成可探索的知识。',name:'瓷艺轩 · iPad 体验设计',en:'CULTURE / TABLET',color:'#3f797a',cover:'88-5709',intro:'围绕瓷器文化、制作技艺与艺术审美组织内容，以平板端体验连接作品欣赏和知识学习，让传统文化以更直观的方式被理解。',tags:['文化内容','平板体验','知识探索'],insights:[['从文化脉络切入','将历史起源、发展与不同时期的演变作为学习背景，帮助读者理解器物背后的文化。'],['让工艺更易理解','围绕拉坯、施釉、烧制等制作过程展开知识内容，串联材料、技艺与作品。'],['以作品承载审美','通过青花、粉彩、釉里红等不同风格建立认识入口，将欣赏与知识探索连接起来。']]},
 {id:'experiments',no:'04',match:'作品4-',title:'在不同尺度里，探索视觉表达。',name:'其他设计 · 视觉探索',en:'EXPERIMENTS / VISUAL',color:'#b06c32',cover:'106-813',intro:'收录图标、信息图表、游戏界面与其他设计草稿。不同载体的尝试，组成作品集中的视觉探索章节。',tags:['图标设计','信息图表','游戏界面'],insights:[['图形语言','观察小尺度图形如何传达信息，探索形态的辨识度与视觉特征。'],['信息组织','通过图表和版式建立阅读顺序，呈现不同类型内容的表达方式。'],['多样化探索','把界面与视觉草稿并置，展示不同设计情境下的探索过程。']]},
];
const labels:Record<string,string>={'25-11':'项目概览','29-21':'项目背景与业务逻辑','32-17':'设计思路','39-263':'视觉与组件规范','49-162':'首页设计','58-66':'首页组件拆解','67-224':'账户中心设计','58-99':'账户中心模块拆解','76-485':'商品详情设计','78-125':'详情页设计逻辑','78-157':'界面展示','99-425':'项目概览','100-277':'背景与目标','126-564':'目标用户与需求','100-297':'视觉规范','126-1442':'设计策略与信息架构','105-595':'品牌与界面展示','130-510':'核心体验总览','130-537':'首页设计','88-5709':'项目概览','88-5724':'文化背景与选题','106-813':'视觉探索概览'};
Object.assign(labels,{'131-773':'搜索与内容检索','131-801':'发现页设计','131-829':'乐圈社区','131-857':'歌单详情','131-885':'沉浸式播放器','135-1772':'播放器交互流程','131-913':'音乐资产与个人主页','135-689':'项目总结','88-5762':'竞品调研','88-6031':'体验规划','88-5878':'视觉与图标规范','88-6282':'首页设计','88-6332':'资料馆','88-6374':'内容模块与页面逻辑','96-195':'制瓷体验流程','99-344':'完整界面展示','109-886':'视觉探索 / 01','109-887':'视觉探索 / 02','109-888':'视觉探索 / 03','110-904':'后台与游戏界面设计'});
const title=(frame:typeof frames[number])=>labels[frame.key]||frame.texts.find(t=>/设计展示-|页面|规范|分析|架构/.test(t)&&t.length<35)||frame.name;
---
<main class="portfolio-web">
 <header class="portfolio-hero shell" id="portfolio-top"><a class="back" href="/project">← 所有项目</a><div class="hero-meta"><span>TOK / SELECTED WORKS</span><span>04 个方向 · UI / UX / VISUAL</span></div><div class="hero-heading"><h1>从问题出发，<span>让设计落在体验里。</span></h1><p>电商、音乐、文化与视觉探索。<br/>记录如何组织信息、连接场景，<br/>并把想法变成可以使用的界面。</p></div><div class="index-heading"><h2>作品索引</h2><span>选择项目，了解设计过程 ↘</span></div><div class="hero-collage">{projects.map(p=><a href={`#${p.id}`} aria-label={`查看${p.name}`}><div class:list={['project-thumbnail',p.id]}><img src={`/assets/projects/portfolio-ui/${({commerce:'commerce-home',music:'music-home',ceramics:'ceramics-home',experiments:'visual-icons'} as Record<string,string>)[p.id]}.webp`} alt={p.name} width="640" height="400"/></div><div class="entry-caption"><small>{p.no}</small><div><h3>{p.name}</h3><p>{p.tags.join(' / ')}</p></div><b aria-hidden="true">↗</b></div></a>)}</div></header>
 <nav id="work-index" class="work-index" aria-label="作品集章节"><div class="shell">{projects.map(p=><a href={`#${p.id}`} aria-label={`跳转到${p.name}`}><small>{p.no}</small><span>{p.name.split(' · ')[0]}</span><span>↗</span></a>)}</div></nav>
 {projects.map(p=>{const pages=frames.filter(f=>f.name.includes(p.match));return <section class="work-section" id={p.id} style={`--accent:${p.color}`}><div class="shell"><header class="work-header"><p class="eyebrow">{p.no} / {p.en}</p><h2>{p.title}</h2><div class="overview"><h3>{p.name}</h3><div><p>{p.intro}</p><div class="tags">{p.tags.map(t=><span>{t}</span>)}</div></div></div></header><div class="insights">{p.insights.map((item,i)=><article><span>0{i+1}</span><h4>{item[0]}</h4><p>{item[1]}</p></article>)}</div><PortfolioCaseContent id={p.id}/><a class="back-index" href="#portfolio-top">返回作品索引 ↑</a></div></section>})}
 <footer class="portfolio-end shell"><p class="eyebrow">CONTINUE EXPLORING</p><h2>让设计，回到真实的使用场景。</h2><p>从需求理解到界面落地，持续探索清晰、连贯而有温度的数字体验。</p><a href="/project">继续浏览其他项目 ↗</a></footer>
 <dialog class="artwork-viewer" aria-labelledby="artwork-title"><header><h2 id="artwork-title">设计原图</h2><button class="viewer-close" aria-label="关闭设计原图">关闭 ×</button></header><div class="viewer-body"><p class="image-status" role="status" hidden></p><img alt=""/><button class="image-retry" hidden>重新加载</button></div><p>按 Esc 或点击关闭返回作品集；长图可上下滚动查看。</p></dialog>
</main>
<script>
 const viewer=document.querySelector<HTMLDialogElement>('.artwork-viewer');
 const artwork=viewer?.querySelector<HTMLImageElement>('.viewer-body img');
 const heading=viewer?.querySelector('#artwork-title');
 const status=viewer?.querySelector<HTMLElement>('.image-status');
 const retry=viewer?.querySelector<HTMLButtonElement>('.image-retry');
 artwork?.addEventListener('load',()=>{artwork.hidden=false;if(status)status.hidden=true;if(retry)retry.hidden=true;});
 artwork?.addEventListener('error',()=>{artwork.hidden=true;if(status){status.hidden=false;status.textContent='图片暂时无法加载，请重试。'}if(retry)retry.hidden=false;});
 retry?.addEventListener('click',()=>{if(artwork){if(status)status.textContent='正在加载图片…';retry.hidden=true;const src=artwork.src;artwork.removeAttribute('src');artwork.src=src;}});
 let oldOverflow='';
 document.querySelectorAll<HTMLButtonElement>('.board-preview').forEach(button=>button.addEventListener('click',()=>{
  if(!viewer||!artwork||!heading)return;
  if(status){status.hidden=false;status.textContent='正在加载图片…';}if(retry)retry.hidden=true;artwork.hidden=true;
  artwork.src=button.dataset.image||'';artwork.alt=button.dataset.title||'设计原图';heading.textContent=artwork.alt;
  oldOverflow=document.body.style.overflow;document.body.style.overflow='hidden';viewer.showModal();
  const body=viewer.querySelector('.viewer-body');if(body)body.scrollTop=0;
 }));
 viewer?.querySelector('.viewer-close')?.addEventListener('click',()=>viewer.close());
 viewer?.addEventListener('click',event=>{if(event.target===viewer)viewer.close()});
 viewer?.addEventListener('close',()=>{document.body.style.overflow=oldOverflow});
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 const chapterLinks=document.querySelectorAll<HTMLAnchorElement>('.work-index a');
 const sections=document.querySelectorAll<HTMLElement>('.portfolio-web .work-section');
 let chapterFrame=false;
 const updateChapter=()=>{
  let active=sections[0]?.id;
  sections.forEach(section=>{if(section.getBoundingClientRect().top<innerHeight*.4)active=section.id});
  chapterLinks.forEach(link=>{if(link.hash===`#${active}`)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current')});
  chapterFrame=false;
 };
 const scheduleChapterUpdate=()=>{if(!chapterFrame){chapterFrame=true;requestAnimationFrame(updateChapter)}};
 document.body.addEventListener('scroll',scheduleChapterUpdate,{passive:true});
 addEventListener('scroll',scheduleChapterUpdate,{passive:true});
 addEventListener('hashchange',scheduleChapterUpdate);
 updateChapter();
 if(!reduced.matches&&'IntersectionObserver' in window){
  const items=document.querySelectorAll('.portfolio-web .work-header,.portfolio-web .insights');
  const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');observer.unobserve(entry.target)}}),{threshold:.06});
  items.forEach(item=>{item.classList.add('reveal');observer.observe(item)});
 }
</script>
