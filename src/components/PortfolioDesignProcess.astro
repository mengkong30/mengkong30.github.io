---
import { processNotes } from '../data/portfolio-process';
import dimensions from '../data/portfolio-ui-dimensions.json';
const { id } = Astro.props;
const notes = processNotes[id];
const sizes = dimensions as Record<string, {width:number; height:number}>;
const asset = (key:string) => `/assets/projects/portfolio-ui/${key}.webp`;
---
{notes && <section class="design-process" id={`${id}-process`} data-process>
  <header class="process-heading"><div><p class="eyebrow">设计过程</p><h3>每一步，都有设计的理由。</h3></div><p>选择一个主题，看看界面背后的取舍。</p></header>
  <div class="process-tabs" aria-label="设计主题">
    {notes.map((note, i) => <button type="button" id={`${id}-tab-${i}`} data-process-tab aria-controls={`${id}-panel-${i}`}>{note.topic}</button>)}
  </div>
  {notes.map((note, i) => <section class="process-panel" id={`${id}-panel-${i}`} aria-labelledby={`${id}-tab-${i}`} data-process-panel>
    <div class="process-intro"><p class="eyebrow">{note.topic}</p><h4>{note.title}</h4><p>{note.intro}</p></div>
    <div class="process-layout">
      <figure class:list={['process-visual', {portrait: sizes[note.image].height > sizes[note.image].width}]}>
        <button type="button" class="board-preview" data-image={asset(note.image)} data-title={note.imageTitle} aria-label={`放大查看${note.imageTitle}`}><img src={asset(note.image)} alt={note.imageTitle} width={sizes[note.image].width} height={sizes[note.image].height} loading="lazy" decoding="async"/></button>
        <figcaption><span>{note.imageTitle}</span><span>点击查看原图 ↗</span></figcaption>
      </figure>
      <div class="process-decisions">{note.decisions.map(([title, body]) => <article><h5>{title}</h5><p>{body}</p></article>)}
        {note.path && <ol class="process-path" aria-label="体验路径">{note.path.map(step => <li>{step}</li>)}</ol>}
      </div>
    </div>
  </section>)}
</section>}
<script>
  document.querySelectorAll<HTMLElement>('[data-process]').forEach(root => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-process-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-process-panel]'));
    root.querySelector('.process-tabs')?.setAttribute('role', 'tablist');
    const select = (index: number) => {
      tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; panels[i].hidden = i !== index; });
    };
    tabs.forEach((tab, i) => {
      tab.setAttribute('role', 'tab'); panels[i].setAttribute('role', 'tabpanel'); panels[i].tabIndex = 0;
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', event => {
        const next = event.key === 'ArrowRight' ? (i + 1) % tabs.length : event.key === 'ArrowLeft' ? (i - 1 + tabs.length) % tabs.length : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : -1;
        if (next < 0) return; event.preventDefault(); select(next); tabs[next].focus();
      });
    });
    select(0);
  });
</script>
<style>
  .design-process{margin:64px 0 20px;padding-top:36px;border-top:1px solid var(--portfolio-line);color:var(--portfolio-ink);scroll-margin-top:36px}
  .process-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:30px}.eyebrow{font-size:12px;color:var(--accent);margin:0 0 12px;letter-spacing:.08em}.process-heading h3{font-size:clamp(24px,2.6vw,36px);letter-spacing:-.035em;line-height:1.3;margin:0;font-weight:600}.process-heading>p{font-size:13px;line-height:1.8;color:var(--portfolio-muted);margin:0}
  .process-tabs{display:flex;gap:8px;flex-wrap:wrap;border-bottom:1px solid var(--portfolio-line);padding-bottom:14px}.process-tabs button{font:inherit;font-size:14px;color:var(--portfolio-muted);border:1px solid transparent;background:transparent;padding:11px 19px;border-radius:4px;cursor:pointer;transition:background .2s,color .2s}.process-tabs button:hover{background:var(--portfolio-panel);color:var(--portfolio-ink)}.process-tabs button[aria-selected=true]{background:var(--portfolio-ink);color:var(--portfolio-bg)}
  .process-panel{padding-top:32px}.process-panel[hidden]{display:none}.process-intro{display:grid;grid-template-columns:1fr 1fr;gap:0 48px;margin-bottom:28px;align-items:start}.process-intro .eyebrow{grid-column:1/-1}.process-intro h4{font-size:clamp(23px,2.4vw,32px);line-height:1.45;letter-spacing:-.03em;margin:0;font-weight:550}.process-intro>p:last-child{font-size:15px;line-height:1.9;margin:0;color:var(--portfolio-muted)}
  .process-layout{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:48px;align-items:start}.process-visual{margin:0;min-width:0;background:var(--portfolio-panel);padding:20px;border-radius:6px}.process-visual button{display:block;width:100%;border:0;background:transparent;padding:0;cursor:zoom-in}.process-visual img{display:block;width:100%;height:auto;max-height:360px;object-fit:contain;transition:transform .3s}.process-visual button:hover img{transform:scale(1.025)}.process-visual.portrait img{height:340px;width:100%;object-fit:contain}.process-visual figcaption{display:flex;justify-content:space-between;gap:12px;border-top:1px solid var(--portfolio-line);margin-top:20px;padding-top:14px;font-size:11px;line-height:1.6;color:var(--portfolio-muted)}
  .process-decisions article{border-bottom:1px solid var(--portfolio-line);padding:0 0 18px;margin-bottom:18px}.process-decisions h5{font-size:17px;line-height:1.5;margin:0 0 7px;color:var(--portfolio-ink);font-weight:600}.process-decisions p{font-size:14px;line-height:1.9;color:var(--portfolio-muted);margin:0}.process-path{list-style:none;display:flex;flex-wrap:wrap;gap:8px 0;margin:24px 0 0;padding:0;font-size:11px;color:var(--accent);line-height:1.8}.process-path li:not(:last-child)::after{content:'→';margin:0 10px;color:var(--portfolio-muted)}
  button:focus-visible,.process-panel:focus-visible{outline:2px solid var(--accent);outline-offset:5px}
  @media(max-width:800px){.process-heading{display:block}.process-heading>p{margin-top:14px}.process-layout{gap:24px}.process-intro{gap:0 24px}.process-visual{padding:12px}}
  @media(max-width:600px){.design-process{margin-top:40px}.process-tabs{gap:4px}.process-tabs button{padding:10px 12px;font-size:13px}.process-intro,.process-layout{grid-template-columns:1fr;gap:20px}.process-intro .eyebrow{margin-bottom:-10px}.process-intro>p:last-child{font-size:14px}.process-panel{padding-top:24px}.process-visual.portrait img{height:300px}.process-decisions article{padding-bottom:16px;margin-bottom:16px}}
  @media(prefers-reduced-motion:reduce){.process-tabs button,.process-visual img{transition:none}}
</style>
