---
const screen = (name: string) => `/assets/projects/watch-case/screens/${name}.svg`;
const daily = [
 ['daily','整体状态','三项指标，先建立今天的整体印象。'],
 ['steps','步数详情','目标、完成比例与差额一起解释。'],
 ['activity','活动详情','刻度呈现达标，+2 标明超额时长。'],
 ['distance','距离详情','沿标尺查看已走距离与剩余量。'],
];
const heart = [['heart','先看最近读数','读数优先，测量入口留在首屏。'],['measuring','让等待有解释','告知正在测量，以及如何配合。'],['result','给出明确结果','读数与测量时间一起呈现。']];
const sport = [['sport','记录中','时长是主角，暂停始终可见。'],['paused','已暂停','保留本次数据，明确继续或结束。'],['saved','已保存','汇总时长与距离，完成一次记录。']];
const tools = [['breath','呼吸练习'],['timer','计时器'],['alarm','闹钟'],['settings','设置']];
const collections = [
 ['每日状态',[['daily','每日总览'],['steps','步数详情'],['activity','活动详情'],['distance','距离详情']]],
 ['心率',[['heart','最近读数'],['trend','心率趋势'],['measuring','测量中'],['result','测量结果'],['failed','测量失败']]],
 ['睡眠',[['sleep','睡眠总览'],['sleepTimeline','睡眠时间轴'],['sleepStages','睡眠阶段']]],
 ['运动',[['sport','运动记录'],['sportDistance','运动距离'],['sportHeart','运动心率'],['paused','已暂停'],['confirm','结束确认'],['saving','正在保存'],['saved','运动摘要'],['saveFailed','保存失败']]],
 ['日常工具',[['breath','呼吸准备'],['breathing','呼吸进行中'],['breathDone','呼吸完成'],['timer','计时准备'],['timerRunning','计时进行中'],['timerPaused','计时暂停'],['timerDone','计时结束'],['alarm','闹钟列表'],['alarmEdit','编辑闹钟'],['alarmSaved','闹钟已保存'],['alarmRinging','闹钟响铃'],['alarmSnoozed','稍后提醒']]],
 ['设置',[['settings','设置首页'],['faces','表盘选择'],['settingSaved','表盘已应用'],['vibration','振动强度'],['brightness','屏幕亮度'],['dnd','勿扰模式']]],
] as const;
---
<article class="watch-case" id="case-top">
 <header class="case-hero">
  <div class="case-wrap hero-grid">
   <div class="hero-copy"><a class="case-back" href="/project">← 全部项目</a><p class="eyebrow">SMARTWATCH / UI DESIGN</p><h1>抬腕看懂，<br/><span>再按需深入。</span></h1><p class="hero-description">把健康与轻运动的信息，<br/>整理成一瞥能读懂、下一步有方向的小屏体验。</p><a class="hero-link" href="#decision">看看设计如何展开 <span>↘</span></a></div>
   <div class="hero-visual"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><img src="/assets/projects/watch-case/watch.png" width="1024" height="1024" alt="黑色智能手表样机，屏幕显示步数、活动与距离三环总览" fetchpriority="high"/><span class="visual-label">DAILY ACTIVITY<br/><b>从整体，到细节。</b></span></div>
  </div>
  <div class="case-wrap project-meta"><div><span>项目方向</span><strong>健康与轻运动</strong></div><div><span>设计范围</span><strong>界面 · 组件 · 状态</strong></div><div><span>目标屏幕</span><strong>456 × 456</strong></div><div><span>项目类型</span><strong>个人概念设计</strong></div></div>
 </header>
 <nav class="case-nav" aria-label="项目章节"><span class="case-progress" aria-hidden="true"></span><div class="case-wrap"><a href="#decision">设计思路</a><a href="#daily">每日状态</a><a href="#heart">心率</a><a href="#sleep">睡眠</a><a href="#sport">运动</a><a href="#system">视觉系统</a><a href="#all-screens">全部界面</a></div></nav>
 <section class="case-section decision case-wrap" id="decision">
  <div class="section-top"><p class="eyebrow">01 / THE DESIGN QUESTION</p><p class="section-aside">短暂的一瞥，需要清楚的阅读顺序。</p></div>
  <div class="decision-grid"><div><h2>小屏幕，<br/>不必一次说完。</h2><p class="large-copy">先回答“今天怎么样”，<br/>再回答“离目标还有多少”。</p><p class="body-copy">手表上的查看往往很短暂。这个方案把总览、详情与操作分开，让每一屏承担一个明确任务，而不是同时争夺注意力。</p><p class="assumption">设计假设：先建立整体印象，再按需寻找解释。</p></div><div class="decision-art"><div class="screen-number">01 <span>GLANCE</span></div><button class="screen-image" data-image={screen('daily')} data-title="每日状态 · 三项指标总览"><img src={screen('daily')} alt="每日状态总览：步数 6280，活动 32 分钟，距离 4.2 公里" width="456" height="456" loading="lazy"/></button><div class="reading-strip"><span>看状态</span><i>→</i><span>查详情</span><i>→</i><span>做操作</span></div></div></div>
  <div class="tradeoff"><span>设计取舍</span><p>总览保留三项结果，目标、比例与剩余量进入详情。<strong>首屏更容易聚焦，但查看目标会多一次浏览。</strong>详情入口能否被发现，是后续需要验证的重点。</p></div>
 </section>
 <section class="case-section daily-section" id="daily"><div class="case-wrap">
  <div class="section-top"><p class="eyebrow">02 / DAILY ACTIVITY</p><span class="section-aside">一组数据，四个层次。</span></div>
  <div class="section-heading"><h2>先看关系，<br/>再看每一项。</h2><p>三环把步数、活动与距离放在一起。<br/>向下浏览时，每项指标用自己的图形语言解释进度。</p></div>
  <div class="screens four">{daily.map(([id,title,desc],i)=><figure><div class="screen-index">0{i+1}<span>{i===0?'OVERVIEW':'DETAIL'}</span></div><button class="screen-image" data-image={screen(id)} data-title={title}><img src={screen(id)} alt={title} width="456" height="456" loading="lazy"/></button><figcaption><h3>{title}</h3><p>{desc}</p></figcaption></figure>)}</div>
  <div class="data-explainer"><div><b>78.5<span>%</span></b><p>6,280 / 8,000 步<br/><strong>比例对应进度条长度</strong></p></div><div><b>+2<span>分钟</span></b><p>32 / 30 分钟<br/><strong>达标之后仍解释超额</strong></p></div><div><b>0.8<span>公里</span></b><p>4.2 / 5 公里<br/><strong>把差额变成下一步目标</strong></p></div></div>
 </div></section>
 <section class="case-section dark-section" id="heart"><div class="case-wrap">
  <div class="section-top"><p class="eyebrow">03 / HEART RATE</p><span class="section-aside">读数有来源，操作有反馈。</span></div><div class="section-heading"><h2>看见读数，<br/><span>也知道下一步。</span></h2><p>把“开始测量”留在最近读数下方。<br/>进入测量后，用过程说明与结果反馈连接整个任务。</p></div>
  <div class="screens three">{heart.map(([id,title,desc])=><figure><button class="screen-image" data-image={screen(id)} data-title={title}><img src={screen(id)} alt={title} width="456" height="456" loading="lazy"/></button><figcaption><h3>{title}</h3><p>{desc}</p></figcaption></figure>)}</div>
  <div class="exception"><img src={screen('failed')} alt="测量失败后提供返回与重新测量" width="456" height="456" loading="lazy"/><div><p class="eyebrow">当测量没有成功</p><h3>说明原因，也留下出口。</h3><p>提示调整佩戴，再选择重试或返回。失败状态仍然延续同一套信息层级，不让任务停在一个没有方向的提示里。</p></div><span class="exception-mark" aria-hidden="true">↗</span></div>
 </div></section>
 <section class="case-section case-wrap" id="sleep"><div class="section-top"><p class="eyebrow">04 / SLEEP</p><span class="section-aside">先交代时间，再解释结构。</span></div><div class="section-heading"><h2>睡了多久，<br/>每一段是什么。</h2><p>总览强调昨晚的总时长与起止时间。<br/>时间轴回答“何时发生”，阶段详情回答“各占多久”。</p></div>
  <div class="sleep-layout"><figure class="sleep-overview"><button class="screen-image" data-image={screen('sleep')} data-title="睡眠总览"><img src={screen('sleep')} width="456" height="456" loading="lazy" alt="昨晚睡眠共 7 时 42 分，23:18 至 07:00"/></button><figcaption><h3>昨晚睡眠 · 总时长</h3><p>7 时 42 分，对应同一晚的三个睡眠阶段。</p></figcaption></figure><div class="sleep-details"><div class="screens two">{[['sleepTimeline','按时间阅读'],['sleepStages','按阶段比较']].map(([id,title])=><figure><button class="screen-image" data-image={screen(id)} data-title={title}><img src={screen(id)} alt={title} width="456" height="456" loading="lazy"/></button><figcaption><h3>{title}</h3></figcaption></figure>)}</div><div class="sleep-legend"><span><i style="--stage:#a6c8ff"></i>浅睡 <b>4时34分</b></span><span><i style="--stage:#3478ff"></i>深睡 <b>1时32分</b></span><span><i style="--stage:#25ed91"></i>REM <b>1时36分</b></span></div><p class="small-copy">颜色与阶段一一对应，图例紧邻图形。所有数值为界面展示用示例数据。</p></div></div>
 </section>
 <section class="case-section sport-section" id="sport"><div class="case-wrap"><div class="section-top"><p class="eyebrow">05 / LIGHT WORKOUT</p><span class="section-aside">从开始记录，到确认保存。</span></div><div class="section-heading"><h2>每一个状态，<br/>都接得住下一步。</h2><p>运动时突出时长与暂停。<br/>暂停后再选择继续或结束，结束前确认，保存后回看摘要。</p></div><div class="screens three">{sport.map(([id,title,desc],i)=><figure><div class="screen-index">0{i+1}<span>{['RECORD','PAUSE','SUMMARY'][i]}</span></div><button class="screen-image" data-image={screen(id)} data-title={title}><img src={screen(id)} alt={title} width="456" height="456" loading="lazy"/></button><figcaption><h3>{title}</h3><p>{desc}</p></figcaption></figure>)}</div><div class="flow-footnote"><span>记录</span><i>→</i><span>暂停 / 继续</span><i>→</i><span>结束确认</span><i>→</i><span>保存反馈</span></div><p class="center-note">保存失败时保留本次会话的数据，并提供重新保存入口。</p></div></section>
 <section class="case-section case-wrap" id="system"><div class="section-top"><p class="eyebrow">06 / ONE VISUAL LANGUAGE</p><span class="section-aside">从健康数据，延伸到日常工具。</span></div><div class="section-heading"><h2>不同任务，<br/>同一种阅读习惯。</h2><p>标题、主要内容、底部操作保持相对稳定。<br/>减少切换页面时重新寻找信息的成本。</p></div><div class="screens four">{tools.map(([id,title])=><figure><button class="screen-image" data-image={screen(id)} data-title={title}><img src={screen(id)} alt={title} width="456" height="456" loading="lazy"/></button><figcaption><h3>{title}</h3></figcaption></figure>)}</div><div class="system-grid"><div class="type-sample"><span class="eyebrow">TYPOGRAPHY</span><strong>72<span>次/分</span></strong><p>读数突出，单位退后。<br/>Noto Sans SC · 用字号与明暗建立层级。</p></div><div class="color-system"><span class="eyebrow">COLOR WITH A PURPOSE</span><div class="swatches">{[['#3478ff','蓝色','主要操作 / 步数'],['#25ed91','绿色','活动 / 达成'],['#ff4166','红色','心率 / 距离']].map(([color,title,desc])=><div><i style={`background:${color}`}></i><h3>{title}</h3><p>{desc}</p></div>)}</div></div></div></section>
 <footer class="case-closing"><div class="case-wrap"><p class="eyebrow">REFLECTION / NEXT STEP</p><h2>让每次抬腕，<br/>更接近答案。</h2><div class="closing-grid"><p>本次设计围绕“总览 → 详情 → 操作”组织信息，完成核心页面、共享视觉规则与关键状态。下一步，需要把这些设计判断放到真实使用中验证。</p><div class="validation"><span>实际尺寸下，读数是否清晰</span><span>详情入口，能否自然发现</span><span>运动过程中，操作是否容易触达</span></div></div><div class="closing-bottom"><span>个人概念项目 · 尚未进行用户可用性测试</span><a href="#case-top">回到顶部 ↑</a><a href="/project">查看其他项目 ↗</a></div></div></footer>
 <section class="case-section overview-section" id="all-screens"><div class="case-wrap">
  <div class="collection-masthead"><p class="eyebrow">07 / THE SCREEN COLLECTION</p><span>456 × 456 · 38 SCREENS</span></div>
  <div class="collection-cover"><div class="collection-title"><p>一块小屏幕里的</p><h2>完整日常<span>。</span></h2><div class="collection-summary"><span>38</span><p>个界面与状态<br/>从一眼读懂，到每一步有回应。</p></div><a href="#collection-index">浏览全部界面 ↓</a></div><div class="collection-featured" aria-label="每日状态、心率与运动界面精选">{[['heart','心率'],['daily','每日状态'],['sport','运动记录']].map(([id,title],i)=><figure class={`featured-${i}`}><button class="screen-image" data-image={screen(id)} data-title={title}><img src={screen(id)} alt={title} width="456" height="456" loading="lazy"/></button><figcaption>{['HEALTH','DAILY','MOVE'][i]}</figcaption></figure>)}</div></div>
  <div class="collection-index" id="collection-index"><span class="index-label">界面索引 / INDEX</span><div class="overview-filters" role="group" aria-label="筛选全部界面"><button data-screen-filter="全部" aria-pressed="true">全部 <span>38</span></button>{collections.map(([name,pages])=><button data-screen-filter={name} aria-pressed="false">{name} <span>{pages.length}</span></button>)}</div></div>
  <p class="overview-count" role="status" aria-live="polite">显示全部 38 个界面 · 点击查看细节</p>
  <div class="collection-groups">{collections.map(([category,pages],index)=><section class="collection-group" data-collection-group={category} style={`--collection-accent:${['#8cb5ff','#ff829e','#bccaff','#65e6af','#8cb5ff','#c3d0e2'][index]}`}>
   <header class="collection-heading"><div><span class="collection-number">0{index+1}</span><h3>{category}</h3></div><p>{['先看整体，再展开每一项。','读数、过程与结果，连成一个任务。','用总时长建立印象，用阶段解释一晚。','从记录到保存，每一步都有反馈。','留一点时间，照顾日常的小事。','把熟悉的使用习惯，留在腕上。'][index]}</p><span class="collection-total">{String(pages.length).padStart(2,'0')} SCREENS</span></header>
   <div class="collection-composition"><figure class="collection-lead" data-screen-category={category}><button class="screen-image" data-image={screen(pages[0][0])} data-title={`${category} · ${pages[0][1]}`}><img src={screen(pages[0][0])} alt={`${category} · ${pages[0][1]}`} width="456" height="456" loading="lazy"/></button><figcaption><span>主界面 / OVERVIEW</span><h4>{pages[0][1]}</h4></figcaption></figure><div class="collection-details">{pages.slice(1).map(([id,title],i)=><figure data-screen-category={category}><div class="detail-order">{String(i+2).padStart(2,'0')}<span aria-hidden="true">↗</span></div><button class="screen-image" data-image={screen(id)} data-title={`${category} · ${title}`}><img src={screen(id)} alt={`${category} · ${title}`} width="456" height="456" loading="lazy"/></button><figcaption><h4>{title}</h4></figcaption></figure>)}</div></div>
  </section>)}</div>
  <div class="collection-end"><span>38 个界面，同一种阅读秩序。</span><a href="#collection-index">回到界面索引 ↑</a></div>
 </div></section>
 <dialog class="case-lightbox" aria-label="界面大图"><button class="lightbox-close" aria-label="关闭大图">×</button><img width="456" height="456" alt=""/><p></p></dialog>
</article>
<script>
 import { initWatchCase } from '../scripts/watch-case-motion';
 initWatchCase();
</script>
<style>
 .case-progress{position:absolute;bottom:-1px;left:0;width:100%;height:2px;background:#2668f4;transform:scaleX(0);transform-origin:left;pointer-events:none}
 .case-nav a[aria-current=location]{color:#1858dc;font-weight:700}
 @media(prefers-reduced-motion:no-preference){.watch-case .hero-link span{transition:transform .25s}.watch-case .hero-link:hover span{transform:translate(4px,4px)}}
</style>
<style>
 .overview-section{background:#0b1421;color:#f1f5fb;padding-block:72px 55px}.collection-masthead{display:flex;justify-content:space-between;align-items:center;padding-bottom:24px;border-bottom:1px solid #2a3a50}.collection-masthead .eyebrow{color:#96b7ee}.collection-masthead>span{font-size:10px;letter-spacing:.12em;color:#8b9bb1}.collection-cover{display:grid;grid-template-columns:.9fr 1.3fr;gap:28px;align-items:center;min-height:485px;padding-block:48px}.collection-title>p{font-size:22px;color:#c1d0e6;margin-bottom:15px}.watch-case .collection-title h2{font-size:clamp(52px,5.5vw,80px);font-weight:750;letter-spacing:-.07em;color:#f4f7fc;white-space:nowrap}.collection-title h2>span{color:#71a3ff}.collection-summary{display:flex;gap:23px;align-items:center;margin-top:30px}.collection-summary>span{font-size:65px;font-weight:350;line-height:1;color:#8cb5ff;letter-spacing:-.065em}.collection-summary p{font-size:13px;line-height:1.9;color:#acbdd4}.collection-title>a{display:inline-block;margin-top:32px;font-size:12px;color:#d8e6fb;border-bottom:1px solid #536d91;padding-bottom:10px}.collection-featured{display:grid;grid-template-columns:.8fr 1.15fr .8fr;gap:18px;align-items:center;position:relative;padding-block:25px}.collection-featured .featured-0{transform:translateY(44px)}.collection-featured .featured-2{transform:translateY(-40px)}.collection-featured img{box-shadow:0 24px 45px #0005}.collection-featured figcaption{font-size:9px;letter-spacing:.18em;color:#8499b7;margin-top:18px}.collection-index{display:flex;align-items:center;gap:36px;border-top:1px solid #2a3a50;border-bottom:1px solid #2a3a50;padding:18px 0;scroll-margin-top:125px}.index-label{font-size:10px;color:#8d9eb7;white-space:nowrap;letter-spacing:.06em}.overview-filters{display:flex;flex-wrap:wrap;gap:10px 20px}.overview-filters button{border:0;border-bottom:2px solid transparent;padding:9px 0;background:transparent;font:inherit;font-size:13px;color:#b1bed1;cursor:pointer}.overview-filters button span{font-size:9px;color:#788da9;margin-left:5px}.overview-filters button[aria-pressed=true]{border-bottom-color:#8cb5ff;color:#fff}.overview-count{font-size:11px;color:#8a9bb5;margin:18px 0 0!important}.collection-group{padding:44px 0 52px;border-bottom:1px solid #26374c}.collection-group[hidden],.collection-group figure[hidden]{display:none}.collection-heading{display:grid;grid-template-columns:1fr 1.1fr auto;gap:28px;align-items:center;margin-bottom:32px}.collection-heading>div{display:flex;align-items:center;gap:20px}.collection-number{font-size:34px;font-weight:350;color:var(--collection-accent);letter-spacing:-.055em}.watch-case .collection-heading h3{font-size:25px;font-weight:650;color:#f0f5fc;letter-spacing:-.025em}.collection-heading p{font-size:12px;line-height:1.8;color:#a2b4cf}.collection-total{font-size:9px;letter-spacing:.1em;color:#8295b1}.collection-composition{display:grid;grid-template-columns:280px 1fr;gap:65px;align-items:start}.collection-lead{padding-top:4px}.collection-lead figcaption{margin-top:19px}.collection-lead figcaption>span{color:var(--collection-accent);font-size:9px;letter-spacing:.06em}.watch-case .collection-group h4{color:#dce8f8;font-size:13px;line-height:1.5;font-weight:550;margin:6px 0 0}.collection-lead h4{font-size:16px!important}.collection-details{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:30px 24px;padding-top:24px}.collection-details figure:nth-child(even){padding-top:28px}.collection-details figcaption{margin-top:13px}.detail-order{font-size:10px;color:#778ca9;display:flex;justify-content:space-between;margin-bottom:12px}.detail-order span{color:var(--collection-accent);font-size:14px}.collection-group:nth-child(1) .collection-details{grid-template-columns:repeat(3,minmax(0,1fr))}.collection-group:nth-child(3) .collection-details{grid-template-columns:repeat(2,minmax(0,1fr));max-width:530px;margin-left:auto;width:100%}.collection-end{display:flex;justify-content:space-between;gap:24px;padding-top:30px;font