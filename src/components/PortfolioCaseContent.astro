---
import source from '../data/portfolio-figma.json';
import imageDimensions from '../data/portfolio-ui-dimensions.json';
const dimensions:Record<string,{width:number;height:number}>=imageDimensions;
const {id}=Astro.props;
const asset=(key:string)=>`/assets/projects/portfolio-ui/${key}.webp`;
const screens:Record<string,{key:string;title:string;intro:string;logic:string[]}[]>={
 commerce:[
 {key:'commerce-home',title:'首页 / 从品牌到选品',intro:'首页把品牌印象、分类引导与商品浏览连接起来，为采购提供清晰起点。',logic:['导航与搜索分工明确：分类用于探索，关键词用于目标明确的找货。','活动卡片用色彩区分主题，引导进入具体品类。','商品卡片按图片、名称、标签、价格组织内容，把决策信息前置。']},
 {key:'commerce-account',title:'账户中心 / 集中管理采购',intro:'将账户信息、订单与常用服务放在同一处，服务采购后的持续管理。',logic:['左侧分类导航保持当前位置清晰，减少重复定位。','余额、订单与高频入口前置，让用户快速获取账户状态。','收藏、关注与最近浏览承接再次采购的需求。']},
 {key:'commerce-detail',title:'商品详情 / 信息先于行动',intro:'以信息清晰、信任建立与行动引导组成商品决策路径。',logic:['大图承载外观与材质细节，标题和价格突出核心信息。','颜色、规格和采购条件集中呈现，减少上下查找。','加购与购买区分两种采购意图，相关商品承接进一步探索。']}
 ],
 music:[
 {key:'music-home',title:'首页',intro:'快速发现符合当下心情的音乐。',logic:['推荐卡片明确内容层级，搜索入口支持主动查找。','品牌渐变建立氛围，Mini Player 延续播放。']},
 {key:'music-search',title:'搜索',intro:'让歌曲、歌手与歌词检索更有条理。',logic:['历史记录支持快速回访。','热门搜索标签提供探索方向，不与结果内容混在一起。']},
 {key:'music-discover',title:'发现',intro:'从偏好、分类和榜单寻找新音乐。',logic:['分类标签帮助定位兴趣。','排行榜与专题推荐提供不同发现路径，模块化布局控制阅读压力。']},
 {key:'music-community',title:'乐圈',intro:'把听歌延伸为资讯浏览与社区参与。',logic:['歌手资讯、话题与分享内容分区组织。','音乐相关内容成为互动情境，让分享不脱离产品核心。']},
 {key:'music-playlist',title:'歌单详情',intro:'先了解歌单，再进入播放。',logic:['封面与简介帮助判断风格，主要播放操作集中呈现。','歌曲列表保持统一布局，支持连续浏览。']},
 {key:'music-player',title:'播放',intro:'让视线回到封面和播放控制。',logic:['渐变背景营造音乐氛围，居中封面建立视觉焦点。','核心控制独立成区，减少无关信息对播放的干扰。']},
 {key:'music-lyrics',title:'播放状态展示',intro:'以不同播放视图延续沉浸体验。',logic:['视觉变化围绕正在播放的内容展开。','页面切换与返回仍需保持播放连续性。']},
 {key:'music-me',title:'我的音乐',intro:'集中整理个人音乐资产。',logic:['收藏、下载、最近播放等高频入口集中展示。','我的歌单与内容记录分层，保持与其他页面一致的组件语言。']}
 ],
 ceramics:[
 {key:'ceramics-home',title:'首页 / 先看见器物之美',intro:'以藏品展示建立第一印象，再引导到不同内容分类。',logic:['主展示区域突出器物细节，而不是同时堆叠所有信息。','底部分类提供进一步探索的入口，衔接欣赏与学习。']},
 {key:'ceramics-library',title:'资料馆 / 从欣赏走向理解',intro:'把文化内容整理成可以逐步浏览的知识空间。',logic:['清晰导航帮助定位内容，减少跨分类寻找的成本。','图文层级兼顾器物欣赏与背景知识阅读。']},
 {key:'ceramics-era',title:'时代 / 沿着历史认识瓷器',intro:'通过时间轴与藏品卡片建立历史脉络。',logic:['历史时期线性排列，当前节点突出显示。','卡片以时代标签、品属分类和器物图片帮助判断内容。','宣纸纹理与传统元素提供文化氛围，留白维持阅读秩序。']}
 ],
 experiments:[
 {key:'visual-icons',title:'图形与视觉探索',intro:'探索图形构成、色彩关系与视觉表达。',logic:['以图形、色彩与构成探索不同表达方式。']},
 {key:'visual-study-two',title:'视觉作品 / 02',intro:'通过图形与构图建立鲜明的视觉印象。',logic:['作为视觉素材展示，保留作品本身的构图与细节。']},
 {key:'visual-study-three',title:'视觉作品 / 03',intro:'延续图形语言，探索不同的视觉组合。',logic:['结合主体与背景的关系，突出画面的视觉焦点。']},
 {key:'admin-one',title:'后台界面 / 01',intro:'海外电商后台设计中的界面探索。',logic:['通过导航与内容分区组织信息，让操作入口易于识别。']},
 {key:'admin-two',title:'后台界面 / 02',intro:'展示不同业务内容下的布局方案。',logic:['观察数据、列表和操作区的主次关系，保持后台界面的阅读秩序。']},
 {key:'admin-three',title:'后台界面 / 03',intro:'延续后台场景的视觉与信息组织。',logic:['在重复模块中保持样式一致，减少页面之间的理解成本。']},
 {key:'game-anime',title:'二次元风格游戏 UI',intro:'围绕游戏氛围展开界面视觉探索。',logic:['让界面控件与场景风格协调，同时保留操作层级。']},
 {key:'game-cartoon-one',title:'欧美卡通风格 / 01',intro:'以另一种视觉语言组织游戏界面。',logic:['通过图形轮廓、色彩对比与布局表达功能主次。']},
 {key:'game-cartoon-two',title:'欧美卡通风格 / 02',intro:'呈现同一风格下的界面变化。',logic:['在保持风格一致的同时，为不同内容安排明确的视觉落点。']}
 ]
};
const palettes:Record<string,string[]>={commerce:['#E23947','#FF570F','#3D3D3D','#2070F4','#179C3F'],music:['#9C5CF6','#5658F5','#FD9448','#F4628F','#FDAB35'],ceramics:['#E1D7C9','#73695D','#F1EADB','#F0E8D5','#9C8F74']};
const flows:Record<string,string[]>={commerce:['筛选需求','查看商品','批量下单','物流追踪','售后对接'],music:['发现音乐','浏览歌单','开始播放','分享与收藏'],ceramics:['选土','选土介绍','炼土','画素胚','上釉','烤制','成品']};
const research:Record<string,{title:string;body:string}[]>={
 commerce:[{title:'高效找货',body:'批发商与零售商需要快速定位适合的商品。分类和搜索分别承接探索型与目标型采购。'},{title:'明确成本',body:'价格、起订量、库存与发货仓是采购判断的重要信息，应在决策位置集中出现。'},{title:'把控风险',body:'跨区域采购还涉及库存、物流与售后。用连贯的页面路径承接采购前后信息。'}],
 music:[{title:'学习与通勤中的发现者',body:'关注新音乐、歌单收藏与歌手资讯。设计关注推荐重复、搜索分类不清和管理入口较深等体验问题。'},{title:'工作场景中的连续收听者',body:'希望快速开始播放，根据场景切换歌单，并高效管理收藏。设计重点是少打扰、操作清晰与持续播放。'}],
 ceramics:[{title:'故宫博物院',body:'功能入口与展品分类较丰富。可借鉴细致的内容组织方式。'},{title:'南京博物院',body:'围绕常用功能、院内展品与展览活动展开。可借鉴核心功能的集中呈现。'},{title:'三星堆博物馆',body:'围绕特色展品组织主要功能。可借鉴用代表性内容建立文化识别。'}]
};
const supplemental:Record<string,string[]>={commerce:['29-21','32-17','58-66','58-99','78-125'],music:['100-277','126-564','126-1442','135-1772','135-689'],ceramics:['88-5724','88-5762','88-6031','88-6374'],experiments:[]};
const noteTitles:Record<string,string>={'29-21':'项目背景与业务逻辑','32-17':'采购体验设计策略','58-66':'首页模块解读','58-99':'账户中心模块解读','78-125':'商品详情与购买决策','100-277':'音乐体验的背景与目标','126-564':'用户场景与需求','126-1442':'设计策略与信息架构','135-1772':'播放器交互流程','135-689':'设计总结','88-5724':'文化背景与选题','88-5762':'竞品功能对比','88-6031':'体验规划','88-6374':'时代页的内容与交互'};
const researchImages=['research-palace','research-nanjing','research-sanxingdui'];
const textBlocks=(key:string)=>(source.find(f=>f.key===key)?.texts||[]).filter(t=>t.length>15&&!/^Copyright/.test(t));
---
<div class="case-content">
 {research[id]&&<section class="native-section"><p class="label">RESEARCH / {id==='ceramics'?'竞品观察':'用户与场景'}</p><h3>{id==='commerce'?'把采购需求，拆成清晰的设计任务。':id==='music'?'同样是听歌，期待并不相同。':'从文化产品中，寻找内容组织的线索。'}</h3><div class="research-grid">{research[id].map((item,i)=><article><h4>{item.title}</h4>{id==='ceramics'&&<button class="board-preview research-image" data-image={asset(researchImages[i])} data-title={`${item.title} · 调研界面`} aria-label={`放大查看${item.title}调研界面`}><img src={asset(researchImages[i])} alt={`${item.title}调研界面`} width={i===1?584:562} height="1248" loading="lazy"/><span class="view-label">查看完整界面 ↗</span></button>}<p>{item.body}</p></article>)}</div><p class="boundary">{id==='ceramics'?'三款文化产品都围绕参观指南、票务预订与展品展览建立服务入口。瓷艺轩进一步聚焦器物知识与制瓷体验，将“看见藏品”延伸为“理解文化”。':'设计重点：从具体使用情境出发，明确页面任务与信息优先级。'}</p></section>}
 {flows[id]&&<section class="native-section"><p class="label">EXPERIENCE / {id==='ceramics'?'制瓷体验流程':'体验路径'}</p><h3>{id==='ceramics'?'从选土，到一件作品的诞生。':'让每个页面，都有明确的下一步。'}</h3><ol class="flow">{flows[id].map((step,i)=><li><small>0{i+1}</small><span>{step}</span>{i < flows[id].length - 1&&<b aria-hidden="true">→</b>}</li>)}</ol>{id==='music'&&<div class="playback-flow"><b>持续播放</b><p>Mini Player <span>→</span> 点击展开 <span>→</span> 播放页 <span>→</span> 下滑返回</p><small>切换视图，而不是中断音乐。</small></div>}{id==='commerce'&&<div class="architecture">{['商品体系','仓储体系','物流体系','合规体系'].map(s=><span>{s}</span>)}</div>}</section>}
 {palettes[id]&&<section class="native-section visual-native"><div><p class="label">DESIGN SYSTEM / 设计规范</p><h3>一致的视觉，<br/>支撑连贯的体验。</h3><p>{id==='ceramics'?'采用温润的米色、褐色体系，字体规范包含微软雅黑与 STXingkai。以传统气质承接内容，保持阅读清晰。':'字体规范采用阿里巴巴普惠体 3.0。通过标题、正文和辅助文字区分层级，色彩用于品牌识别与操作反馈。'}</p><small>通过品牌色、辅助色与文字层级，建立可延续的视觉语言。</small></div><div><div class="swatches">{palettes[id].map(color=><div><i style={`background:${color}`}></i><code>{color}</code></div>)}</div><div class="type-demo"><b>Aa</b><div><strong>清晰的标题层级</strong><p>让内容易读，让操作明确。</p><small>标题 / 正文 / 辅助信息</small></div></div></div></section>}
 <section class="native-section"><p class="label">INTERFACE / 页面与设计解读</p><h3>{id==='music'?'从发现到分享，保持音乐的连续性。':id==='ceramics'?'让器物欣赏与文化探索自然衔接。':id==='commerce'?'让信息组织，服务每一次采购。':'把视觉探索，放回具体的界面。'}</h3><p class="boundary">浏览完整界面，并了解每个页面的信息组织与交互设计。点击图片可放大查看。</p><div class:list={['ui-gallery',{'phone-gallery':id==='music','wide-gallery':id==='commerce'}]}>{screens[id].map((screen,i)=><article class="ui-screen"><button class:list={['board-preview','ui-art',{'mockup':id==='commerce'}]} data-image={asset(screen.key)} data-title={screen.title} aria-label={`放大查看${screen.title}`}><img width={dimensions[screen.key].width} height={dimensions[screen.key].height} src={asset(screen.key)} alt={`${screen.title} · 界面设计`} loading="lazy" decoding="async"/><span class="view-label">查看界面 ↗</span></button><div class="ui-copy"><span class="label">{String(i+1).padStart(2,'0')} / SCREEN</span><h4>{screen.title}</h4><p>{screen.intro}</p><div class="logic"><span>设计思路</span><ul>{screen.logic.map(item=><li>{item}</li>)}</ul></div></div></article>)}</div></section>
 {supplemental[id]?.length>0&&<section class="native-section original-notes"><p class="label">DESIGN NOTES / 设计过程</p><h3>进一步阅读设计过程。</h3><p class="boundary">从布局、信息层级到交互路径，展开了解具体设计决策及其目标。</p>{supplemental[id].filter(key=>textBlocks(key).length>0).map((key,i)=><details><summary><span>0{i+1}</span>{noteTitles[key]}<b>＋</b></summary><div>{textBlocks(key).map(t=><p>{t}</p>)}</div></details>)}</section>}
</div>
<style>
 .research-image{margin:22px auto;max-width:270px;border:1px solid #e2e5e7;border-radius:12px;overflow:hidden;background:#f0f1ee}.research-image img{display:block;width:100%;height:auto}.research-grid:has(.research-image){grid-template-columns:repeat(3,minmax(0,1fr))}@media(max-width:650px){.research-grid:has(.research-image){grid-template-columns:1fr}}
 .native-section{margin:65px 0}.label{font-size:10px;letter-spacing:.13em;color:var(--accent);margin:0 0 20px}h3{font-size:clamp(25px,3vw,39px);line-height:1.4;font-weight:550;letter-spacing:-.03em;margin:0 0 28px}.research-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px}.research-grid article{background:#ffffffb0;border:1px solid #dce0e1;border-radius:18px;padding:28px}.research-grid h4{font-size:19px;margin:0 0 15px}.research-grid p,.visual-native p{font-size:14px;line-height:1.95;color:#697482;margin:0}.boundary{font-size:11px;line-height:1.9;color:#808995;margin:20px 0 30px}.flow{list-style:none;padding:0;display:flex;gap:12px;flex-wrap:wrap}.flow li{display:flex;flex:1;min-width:110px;position:relative;flex-direction:column;gap:17px;background:#ffffffb0;border-radius:12px;border:1px solid #dce0e1;padding:24px 18px}.flow small{color:var(--accent);font-size:11px}.flow span{font-size:14px}.flow b{position:absolute;right:-12px;top:44%;color:var(--accent);z-index:1;font-weight:400}.architecture{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:25px}.architecture span{border-bottom:2px solid var(--accent);padding:18px 0;font-size:14px}.playback-flow{padding:25px;border-radius:15px;background:#e9e3f3;margin-top:25px;font-size:14px}.playback-flow span{margin:0 12px;color:var(--accent)}.playback-flow small{color:#737080}.visual-native{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:center}.visual-native small{display:block;color:#9097a1;font-size:10px;line-height:1.7;margin-top:20px}.swatches{display:flex;gap:12px}.swatches>div{flex:1;min-width:0}.swatches i{display:block;height:100px;border-radius:60px;transition:transform .25s}.swatches i:hover{transform:translateY(-8px)}.swatches code{display:block;font-size:10px;margin-top:14px;color:#707782}.type-demo{margin-top:35px;padding-top:25px;border-top:1px solid #d4d9df;display:flex;align-items:center;gap:35px}.type-demo>b{font-size:70px;font-weight:400}.type-demo strong{font-size:20px}.type-demo p{font-size:13px;margin-top:12px}.type-demo small{margin-top:10px}.ui-gallery{display:grid;grid-template-columns:1fr 1fr;gap:50px 30px;align-items:start}.ui-art{border:0;padding:0;display:block;width:100%;position:relative;border-radius:16px;background:#eceef0;overflow:hidden;cursor:zoom-in}.ui-art img{display:block;width:100%;height:auto;transition:transform .3s}.ui-art:hover img{transform:scale(1.025)}.view-label{position:absolute;bottom:16px;right:16px;border-radius:20px;background:#242c3de6;color:white;padding:9px 13px;font-size:10px}.ui-copy{padding-top:25px}.ui-copy h4{font-size:23px;line-height:1.4;margin:15px 0}.ui-copy>p{font-size:14px;line-height:1.9;color:#6f7985}.logic{padding-top:18px;border-top:1px solid #d5dbe0;margin-top:22px}.logic>span{font-size:11px;color:var(--accent)}.logic ul{padding-left:16px;color:#697482;font-size:13px;line-height:1.9;margin-bottom:0}.logic li{margin-top:10px}.wide-gallery{grid-template-columns:1fr}.wide-gallery .ui-screen{display:grid;grid-template-columns:1.5fr 1fr;gap:40px;align-items:center}.wide-gallery .ui-copy{padding:0}.mockup img{width:145%;max-width:none;margin-left:-45%}.phone-gallery{grid-template-columns:repeat(3,minmax(0,1fr));gap:45px 35px}.phone-gallery .ui-art{max-width:270px;margin:auto;background:transparent;box-shadow:0 14px 32px #35324c20;border-radius:22px}.original-notes details{border-top:1px solid #d5dbe0}.original-notes summary{display:flex;align-items:center;gap:18px;padding:22px 0;cursor:pointer;font-size:15px;list-style:none}.original-notes summary>span{font-size:10px;color:var(--accent)}.original-notes summary b{margin-left:auto;font-weight:400}.original-notes details[open] summary b{rotate:45deg}.original-notes details>div{max-width:820px;padding:0 0 25px 35px}.original-notes details p{font-size:14px;color:#697482;white-space:pre-line;line-height:2}.ui-art:focus-visible,summary:focus-visible{outline:3px solid var(--accent);outline-offset:5px}@media(max-width:1000px){.phone-gallery{grid-template-columns:1fr 1fr}.visual-native{gap:30px}.wide-gallery .ui-screen{gap:25px;grid-template-columns:1.2fr 1fr}}@media(max-width:650px){.native-section{margin:45px 0}.visual-native,.ui-gallery,.wide-gallery .ui-screen{grid-template-columns:1fr}.ui-gallery{gap:40px}.wide-gallery .ui-screen{gap:0}.wide-gallery .ui-copy{padding-top:25px}.phone-gallery .ui-art{max-width:280px}.architecture{grid-template-columns:1fr 1fr}.flow{gap:10px}.flow li{min-width:100px}.flow b{display:none}.swatches{gap:7px}.swatches i{height:80px}.swatches code{font-size:8px}.playback-flow{font-size:12px;line-height:2}.playback-flow span{margin:0 5px}}@media(prefers-reduced-motion:reduce){.ui-art img,.swatches i{transition:none}}
</style>
<style>
.native-section{margin:44px 0;padding-top:32px;border-top:1px solid #dce0df}
h3{font-size:clamp(23px,2.4vw,32px);font-weight:550;margin-bottom:24px}
.research-grid article{background:transparent;border:0;border-left:2px solid #dce0df;border-radius:0;padding:4px 22px}
.research-grid h4{font-size:17px}.research-grid p{font-size:13px}.research-image{position:relative;display:block;width:100%;padding:0;margin:20px auto;border-radius:6px;cursor:zoom-in}.research-image:focus-visible{outline:3px solid var(--accent);outline-offset:5px}
.flow li{background:#f0f1ed;border:0;border-radius:5px;padding:20px 16px}.playback-flow{background:#eeebf2;border-radius:6px}
.visual-native{gap:40px}.swatches i{height:76px;border-radius:6px}.type-demo>b{font-size:54px}.type-demo strong{font-size:18px}
.ui-gallery{gap:40px 28px}.ui-art{border-radius:6px;background:#eeefec}.phone-gallery .ui-art{box-shadow:none;max-width:250px;border-radius:16px;border:1px solid #d8d9df}
