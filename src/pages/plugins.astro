---
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import resources from '../data/design-resources.json';
const groups = [
  { kind: 'skill', title: 'Skills', description: '给 AI 助手的设计与制作工作流，按仓库说明安装后使用。' },
  { kind: 'plugin', title: '插件', description: '把 AI 助手与本地设计工具连接起来。' },
];
---
<BlogPostLayout title="插件与 Skills｜TOK" description="公开分享的 UI 界面设计、AE 二维动效制作 Skills，以及 Codex Local Bridge 本地 Figma 桥接插件。">
  <main class="post-wrapper resources-page">
    <SectionHeader tag="Tools & Skills" description="把设计实践整理成可复用的工作流与工具，在 GitHub 公开分享。">插件与 Skills</SectionHeader>
    {groups.map(group => (
      <section class="resource-group" aria-labelledby={'group-' + group.kind}>
        <header class="group-heading"><h2 id={'group-' + group.kind}>{group.title}</h2><p>{group.description}</p></header>
        <div class="resource-list">
          {resources.filter(resource => resource.kind === group.kind).map(resource => (
            <article class="resource" data-resource={resource.slug}>
              <div class="resource-index" aria-hidden="true"><span>{resource.index}</span><small>{resource.kind === 'skill' ? 'SKILL' : 'PLUGIN'}</small></div>
              <div class="resource-content">
                <div class="resource-heading"><h3>{resource.title}</h3><span class="version">{resource.version}</span></div>
                <p class="repository-name">{resource.slug}</p>
                <p class="resource-description">{resource.description}</p>
                <ul class="resource-features" aria-label={resource.title + '适用场景'}>{resource.features.map(feature => <li>{feature}</li>)}</ul>
                <p class="resource-requires">{resource.requirements}</p>
                <div class="resource-actions">
                  <a class="repo-link" href={resource.repository} target="_blank" rel="noopener noreferrer">查看 GitHub <span aria-hidden="true">↗</span></a>
                  <a href={resource.guide} target="_blank" rel="noopener noreferrer">安装与使用 <span aria-hidden="true">↗</span></a>
                  <a href={resource.download} target="_blank" rel="noopener noreferrer">下载 ZIP <span aria-hidden="true">↓</span></a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
    <p class="resources-footer">使用方法、版本更新与问题反馈，请以对应 GitHub 仓库说明为准。</p>
  </main>
</BlogPostLayout>
<style>
  .resources-page { padding-bottom: 64px; }
  .group-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; margin: 12px 0 24px; }
  .group-heading h2 { margin: 0; color: var(--color-100); font-size: 1.5rem; font-weight: 600; }
  .group-heading p { margin: 0; font-size: .875rem; line-height: 1.8; color: var(--color-300); }
  .resource-group + .resource-group { margin-top: 56px; }
  .resource-list { border-top: 1px solid var(--border); }
  .resource { display: grid; grid-template-columns: 100px minmax(0, 1fr); gap: 32px; padding: 36px 0; border-bottom: 1px solid var(--border); }
  .resource-index { color: var(--color-300); padding-top: 3px; display: flex; flex-direction: column; gap: 10px; }
  .resource-index span { color: var(--color-100); font-size: 2.7rem; line-height: 1.2; font-variant-numeric: tabular-nums; font-weight: 500; }
  .resource-index small { font-size: .65rem; letter-spacing: .12em; }
  .resource-heading { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .resource-heading h3 { margin: 0; color: var(--color-100); font-size: 1.55rem; font-weight: 600; line-height: 1.5; }
  .version { border: 1px solid var(--border); border-radius: 5px; padding: 3px 8px; font-size: .75rem; color: var(--color-300); white-space: nowrap; }
  .repository-name { margin: 6px 0 18px; color: var(--color-300); font-size: .8rem; letter-spacing: .02em; overflow-wrap: anywhere; }
  .resource-description { margin: 0; color: var(--color-100); font-size: 1rem; line-height: 1.9; max-width: 780px; }
  .resource-features { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 20px 0 14px; padding: 0; color: var(--color-200); font-size: .875rem; }
  .resource-features li { padding: 0; margin: 0; line-height: 1.7; }
  .resource-requires { color: var(--color-300); font-size: .8rem; line-height: 1.9; margin: 0; }
  .resource-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; margin-top: 24px; }
  .resource-actions a { display: inline-flex; align-items: center; gap: 12px; padding: 11px 0; min-height: 44px; text-decoration: none; color: var(--color-100); font-size: .875rem; }
  .resource-actions .repo-link { padding: 11px 17px; background: var(--color-100); color: var(--color-999); border-radius: 6px; font-weight: 500; }
  .resource-actions a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .resource-actions .repo-link:hover { opacity: .85; text-decoration: none; }
  .resource-actions a:focus-visible { outline: 2px solid var(--color-100); outline-offset: 5px; }
  .resources-footer { margin: 32px 0 0; color: var(--color-300); font-size: .8rem; line-height: 1.8; }
  @media (max-width: 700px) {
    .group-heading { display: block; margin-bottom: 20px; }
    .group-heading p { margin-top: 10px; font-size: .8rem; }
    .resource { grid-template-columns: 48px minmax(0, 1fr); gap: 18px; padding: 28px 0; }
    .resource-index span { font-size: 1.9rem; }
    .resource-index small { font-size: .55rem; letter-spacing: .04em; }
    .resource-heading { gap: 8px; }
    .resource-heading h3 { font-size: 1.2rem; }
    .resource-description { font-size: .9rem; }
    .resource-features { gap: 8px 16px; font-size: .8rem; }
    .resource-actions { gap: 8px 20px; }
    .resource-actions a { font-size: .8rem; }
    .resource-actions .repo-link { padding: 10px 12px; }
  }
</style>
