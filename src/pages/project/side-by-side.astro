---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialResearch from '../../components/SocialResearch.astro';
import SocialScreen from '../../components/SocialScreen.astro';
import SocialMotion from '../../components/SocialMotion.astro';
const groups = [
 {id:'discover',no:'01',en:'DISCOVER YOUR PEOPLE',title:'从一个共同爱好，\n开始认识彼此。',desc:'兴趣成为探索的起点，也成为推荐的解释。通过个人偏好、内容圈子和好友卡片，让用户逐步找到愿意靠近的人。',screens:[
 {key:'interests',name:'兴趣选择',tag:'ONBOARDING',text:'用摄影、咖啡、艺术等图像化选项降低理解成本。步骤提示、已选数量和继续按钮共同交代进度；“以后可以修改”让偏好选择保持轻松。'},
 {key:'explore',name:'探索',tag:'EXPLORE',text:'搜索覆盖兴趣、圈子和用户，兴趣标签提供快速筛选。发现好友入口与圈子推荐分区呈现，让找人和找内容两种意图都有明确去向。'},
 {key:'discover',name:'发现好友',tag:'FIND FRIENDS',text:'人物卡片先呈现共同兴趣，再展示介绍和标签，为喜欢提供具体理由。跳过、喜欢与撤销形成清晰的决策区；双方喜欢后才可聊天的提示说明连接规则。'}]},
 {id:'community',no:'02',en:'A PLACE TO BELONG',title:'把日常的小发现，\n放进共同的圈子。',desc:'首页连接内容与兴趣，圈子承接持续参与。照片、话题和评论让人与人的联系拥有具体的情境。',screens:[
 {key:'home',name:'首页',tag:'HOME FEED',text:'“为你推荐”和“关注”区分两种浏览方式，兴趣圈子与动态内容相互衔接。作者、圈子、发布时间和互动信息形成稳定的阅读层级，让用户从一张照片走向一个人或一个圈子。'},
 {key:'circle',name:'圈子详情',tag:'CIRCLE',text:'封面与圈名建立主题印象，成员信息与简介帮助判断是否合适。加入按钮集中表达主要动作，社区规则位于显眼位置，动态与关于分栏支持进一步了解。'},
 {key:'post',name:'动态详情',tag:'POST & COMMENTS',text:'保留作者和圈子来源，将图片、正文与评论组成完整的内容上下文。关注入口承接对作者的兴趣，评论中的回复关系与底部输入框支持从观看转向参与。'}]},
 {id:'expression',no:'03',en:'SHOW A LITTLE OF YOU',title:'分享你的日常，\n也留下你的个性。',desc:'表达不只发生在发布的一刻。内容、兴趣与个人主页共同构成可被认识的自我介绍。',screens:[
 {key:'create',name:'发布动态',tag:'CREATE POST',text:'正文和照片预览占据主要空间，缩略图与数量提示帮助管理素材。发布圈子和可见范围独立列出，在发布前明确“发到哪里”和“谁能看见”。'},
 {key:'profile',name:'他人主页',tag:'PUBLIC PROFILE',text:'头像、介绍、城市与作品让用户逐步了解对方，共同兴趣则补充建立联系的理由。关注和发送请求区分持续看内容与进一步认识两种关系意图。'},
 {key:'me',name:'我的主页',tag:'MY PROFILE',text:'封面、头像与个人介绍建立身份区域，编辑资料和兴趣入口方便维护自我表达。动态、收藏与圈子分层整理内容；收藏旁的锁形标识提示其私密属性。'}]},
 {id:'connection',no:'04',en:'KEEP THE CONVERSATION GOING',title:'从“我们都喜欢”，\n到“下次一起去”。',desc:'连接成功只是开始。消息页帮助找到需要回应的人，聊天页让共同兴趣自然延续为具体的话题。',screens:[
 {key:'inbox',name:'消息',tag:'INBOX',text:'新连接以头像横排提醒，消息列表用最后一条内容、时间和未读数量帮助判断优先级。消息请求独立收纳，让已有对话与新的联系保持清晰边界。'},
 {key:'chat',name:'聊天',tag:'CONVERSATION',text:'共同兴趣提示和连接成功卡片为第一句话提供背景。双方气泡用颜色与位置区分，照片可以直接进入对话，让交流从抽象问候落到共同的生活体验。'}]},
];
const asset = (key:string)=>`/assets/projects/side-by-side/${key}.webp`;
---
<BaseLayout title="Side by Side｜兴趣社交 App · TOK" description="以共同兴趣连接彼此的社交 App 设计，展示兴趣选择、圈子、动态、主页和聊天等 11 个页面。" keywords="社交App,Side by Side,UI,UX,兴趣社交">
 <main class="social-case">
  <SocialMotion />
  <header class="hero">
   <div class="hero-top wrap"><a href="/">← 返回作品集</a><span>SELECTED WORK / SOCIAL APP</span><span>UI · UX DESIGN</span></div>
   <div class="hero-title wrap"><div class="brand"><i></i><i></i><span>Good things start with shared interests.</span></div><h1>Side <em>by</em> Side<span>找到同频的人，让连接自然发生。</span></h1><p>从喜欢同一杯咖啡，到分享下一段旅程。<br/>围绕共同兴趣展开的移动端社交体验。</p></div>
   <div class="hero-stage"><span class="stage-word" aria-hidden="true">BETTER TOGETHER</span><div class="hero-phones">{['home','discover','chat'].map((key,i)=><img src={asset(key)} width="853" height="1844" alt={['首页设计','发现好友设计','聊天设计'][i]} fetchpriority={i===1?'high':'auto'}/>)}</div><span class="floating-note">✦ Shared interests.<br/>Real conversations.</span></div>
   <div class="hero-bottom wrap"><span>11 SCREENS / 4 CHAPTERS</span><a href="#overview">探索项目 ↓</a><span>FIND YOUR PEOPLE.</span></div>
  </header>
  <section id="overview" class="intro wrap"><p class="eyebrow">THE CONCEPT / 设计概念</p><div class="intro-grid"><h2>有共同话题，<br/>才更容易<span>靠近。</span></h2><div><p>Side by Side 围绕摄影、咖啡、艺术与户外等日常兴趣，连接内容浏览、圈子参与和好友交流。通过共同爱好建立认识彼此的理由，再用动态和对话延续关系。</p><p>这组设计包含 11 个核心页面。案例按照用户从表达偏好、发现同好、参与社区到维持联系的路径，呈现每个页面的功能与设计逻辑。</p><div class="tags"><span>兴趣驱动</span><span>轻量连接</span><span>社区表达</span></div></div></div>
   <nav class="chapters" aria-label="项目章节">{groups.map(g=><a href={`#${g.id}`}><b>{g.no}</b><span>{g.title.split('，')[0]}</span><span>↗</span></a>)}</nav>
  </section>
  <SocialResearch />
  <section class="visual-system wrap"><div><p class="eyebrow">VISUAL LANGUAGE</p><h2>轻盈的界面，<br/>鲜活的生活。</h2><p>蓝紫色用于主要操作和选中状态，浅色背景让照片与人物成为视觉中心。圆角容器与细线图标贯穿各页面，保持亲近而清晰的界面节奏。</p></div><div class="palette"><div><span style="background:#5754ff"></span><b>Connection</b><small>#5754FF</small></div><div><span style="background:#efedff"></span><b>Softness</b><small>#EFEDFF</small></div><div><span style="background:#0c1434"></span><b>Clarity</b><small>#0C1434</small></div></div></section>
  {groups.map(g=><section id={g.id} class:list={['chapter',`chapter-${g.no}`]}><div class="wrap"><header class="chapter-head"><span class="chapter-number">{g.no}</span><div><p class="eyebrow">{g.en}</p><h2>{g.title.split('\n').map(line=><span>{line}</span>)}</h2></div><p>{g.desc}</p></header><div class:list={['screen-grid',{'two-up':g.screens.length===2}]}>{g.screens.map((s,i)=><article class="screen-card"><div class="screen-heading"><span>{g.no}.{i+1}</span><span>{s.tag}</span></div><SocialScreen name={s.name} screenKey={s.key}/><div class="screen-description"><h3>{s.name}</h3><p>{s.text}</p></div></article>)}</div></div></section>)}
  <section class="closing wrap"><p class="eyebrow">SIDE BY SIDE</p><h2>每一段连接，<br/>都从一点<span>共鸣</span>开始。</h2><p>共同兴趣是认识的起点，真实的日常内容让彼此更具体。<br/>用清晰的路径，把探索、表达与交流连接成连续的体验。</p><a href="/project">继续浏览作品 ↗</a></section>
 </main>
</BaseLayout>
<style>
 .social-case{--ink:#111632;--purple:#5754ff;--muted:#72768c;color:var(--ink);background:#fafaff;overflow:hidden}.wrap{width:calc(100% - 96px);max-width:1200px;margin-inline:auto}.hero{background:linear-gradient(160deg,#f5f3ff,#e9edff 65%,#eef1fa)}.hero-top{display:flex;justify-content:space-between;padding-top:32px;font-size:11px;letter-spacing:.06em}.hero-top a{color:var(--ink)}.hero-title{padding-top:86px;position:relative}.brand{display:flex;align-items:center;height:32px}.brand i{width:28px;height:28px;border:4px solid #6973ee;border-radius:50%;display:block}.brand i+i{margin-left:-12px;border-color:#8863c9}.brand span{font-size:12px;letter-spacing:.01em;margin-left:15px;color:var(--muted)}h1{font-size:clamp(62px,9.7vw,140px);line-height:1.03;letter-spacing:-.075em;margin:25px 0;font-weight:700}h1 em{font-family:Georgia,serif;font-weight:400;color:var(--purple)}h1>span{display:block;font-size:clamp(20px,2.5vw,34px);letter-spacing:-.02em;margin-top:26px;font-weight:500}.hero-title>p{color:var(--muted);font-size:15px;line-height:1.9;margin:26px 0 0}.hero-stage{position:relative;margin-top:30px;padding:70px 30px 0;height:680px;overflow:hidden}.hero-phones{display:flex;justify-content:center;gap:56px;position:relative;z-index:1}.hero-phones img{width:270px;height:auto;align-self:flex-start;border-radius:24px;box-shadow:0 26px 60px #34347126;border:5px solid #ffffffc9}.hero-phones img:first-child{transform:rotate(-10deg) translateY(68px)}.hero-phones img:last-child{transform:rotate(10deg) translateY(68px)}.stage-word{position:absolute;white-space:nowrap;left:50%;top:140px;transform:translateX(-50%);font-size:clamp(80px,12vw,180px);font-weight:800;color:#d6dafa;letter-spacing:-.07em}.floating-note{position:absolute;right:5%;top:10px;border:1px solid #c5c7f0;border-radius:50%;padding:25px;font-size:12px;line-height:1.7;transform:rotate(10deg);color:var(--purple)}.hero-bottom{display:flex;justify-content:space-between;align-items:center;padding:28px 0;font-size:10px;letter-spacing:.1em;border-top:1px solid #cbd0ed}.hero-bottom a{color:var(--ink);font-size:13px}.intro{padding:110px 0 80px}.eyebrow{color:var(--purple);font-size:11px;font-weight:600;letter-spacing:.14em;margin:0 0 28px}.intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px}h2{font-size:clamp(32px,4.2vw,58px);line-height:1.3;font-weight:650;letter-spacing:-.04em;margin:0}h2 span{color:var(--purple)}.intro-grid p,.visual-system p:not(.eyebrow){font-size:15px;line-height:1.95;color:var(--muted);margin:0 0 18px}.tags{display:flex;gap:10px;margin-top:28px}.tags span{border:1px solid #dadaef;padding:8px 15px;border-radius:24px;font-size:12px}.chapters{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;margin-top:72px}.chapters a{border-top:1px solid #d4d5e5;padding-top:22px;display:flex;align-items:center;gap:14px;color:var(--ink);font-size:12px}.chapters b{font-size:11px;color:var(--purple)}.chapters a>span:last-child{margin-left:auto}.visual-system{display:grid;grid-template-columns:1fr 1fr;gap:100px;padding:20px 0 110px;align-items:center}.visual-system h2{font-size:36px;margin-bottom:25px}.palette{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.palette div{display:flex;flex-direction:column}.palette span{height:160px;border-radius:80px;margin-bottom:20px}.palette b{font-size:12px}.palette small{font-size:10px;color:var(--muted);margin-top:5px}.chapter{padding:100px 0;scroll-margin-top:25px}.chapter-01,.chapter-03{background:#efeffb}.chapter-02{background:#f9f9fd}.chapter-04{background:#171b37;color:#fafaff}.chapter-head{display:grid;grid-template-columns:70px 1fr .8fr;gap:35px;align-items:start;margin-bottom:64px}.chapter-number{font-family:Georgia,serif;font-size:58px;color:#b6b7d5;line-height:1}.chapter-head h2{font-size:36px}.chapter-head h2 span{display:block;color:inherit}.chapter-head>p{color:var(--muted);line-height:1.9;font-size:14px;margin:40px 0 0;max-width:350px}.chapter-head .eyebrow{margin-bottom:20px}.screen-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:42px}.screen-heading{display:flex;justify-content:space-between;font-size:10px;letter-spacing:.08em;color:var(--muted);margin-bottom:18px}.screen-image{position:relative;display:block;border-radius:20px;box-shadow:0 20px 35px #222b5420;overflow:hidden;background:#f6f6fd;transition:transform .25s}.screen-image:hover{transform:translateY(-7px)}.screen-image img{width:100%;height:auto;display:block}.zoom{position:absolute;bottom:30px;right:15px;background:#171b37e6;color:white;border-radius:30px;padding:9px 14px;font-size:11px;opacity:0;transition:opacity .2s}.screen-image:hover .zoom,.screen-image:focus-visible .zoom{opacity:1}.screen-description h3{font-size:21px;margin:30px 0 15px;font-weight:600}.screen-description p{font-size:14px;line-height:1.95;color:var(--muted);margin:0}.two-up{max-width:860px;margin:auto;gap:80px}.two-up{grid-template-columns:repeat(2,minmax(0,1fr))}.chapter-04 .eyebrow{color:#a6a5ff}.chapter-04 .screen-description p,.chapter-04 .screen-heading,.chapter-04 .chapter-head>p{color:#b7bbd2}.closing{padding:120px 0;text-align:center}.closing h2{font-size:clamp(38px,5.2vw,72px)}.closing>p:not(.eyebrow){font-size:15px;color:var(--muted);line-height:1.9;margin:32px 0}.closing>a{display:inline-block;color:var(--purple);padding:15px 22px;border:1px solid #d3d0f4;border-radius:30px;font-size:13px}a:focus-visible{outline:3px solid var(--purple);outline-offset:6px}@media(max-width:1000px){.hero-phones{gap:26px}.hero-phones img{width:230px}.hero-stage{height:590px}.intro-grid,.visual-system{gap:45px}.screen-grid{gap:22px}.chapter-head{gap:20px;grid-template-columns:50px 1fr .8fr}.chapter-head h2{font-size:30px}.chapters{gap:16px}}@media(max-width:700px){.wrap{width:calc(100% - 40px)}.hero-top{font-size:9px}.hero-top>span:last-child{display:none}.hero-title{padding-top:60px}.brand span{font-size:9px}h1{font-size:66px}.hero-title>p{font-size:13px}.hero-stage{height:410px;padding-top:60px;padding-inline:0}.hero-phones{gap:15px;width:620px;position:relative;left:50%;transform:translateX(-50%)}.hero-phones img{width:180px;border-width:3px;border-radius:17px}.hero-phones img:first-child,.hero-phones img:last-child{transform:translateY(40px)}.floating-note{display:none}.hero-bottom>span:last-child{display:none}.intro{padding:65px 0 50px}.intro-grid,.visual-system{grid-template-columns:1fr;gap:28px}.chapters{grid-template-columns:repeat(2,1fr);margin-top:40px;gap:26px}.visual-system{padding-bottom:60px}.palette span{height:110px}.chapter{padding:56px 0}.chapter-head{grid-template-columns:35px 1fr;gap:20px;margin-bottom:35px}.chapter-number{font-size:36px}.chapter-head h2{font-size:29px}.chapter-head>p{grid-column:2;margin:0;max-width:none}.screen-grid,.two-up{grid-template-columns:1fr;gap:48px;max-width:370px;margin:auto}.screen-image{max-width:330px;margin:auto}.screen-description h3{margin-top:24px}.screen-description p{font-size:14px}.zoom{opacity:1;bottom:18px}.closing{padding:65px 0}.closing>p:not(.eyebrow){font-size:13px}}@media(prefers-reduced-motion:reduce){.screen-image,.zoom{transition:none}}
</style>
