---
import BaseLayout from '../../layouts/BaseLayout.astro';
const screens = [
 {id:'home',label:'01 / HOME',title:'先看见今天，再走近一个瞬间。',name:'首页 · 陪伴概览',intro:'首页围绕家长最直接的三个问题展开：设备是否正常、今天有没有互动、有什么值得回看。信息从状态到概览，再落到具体表达，形成由浅入深的浏览顺序。',points:[['关系先于数据','用“天天的今天”、年龄与日期建立个人语境，Fufu 形象传递熟悉感。在线状态与电量紧随其后，让家长先确认记录来源是否可用。'],['概览帮助快速判断','“今日陪伴”只突出互动时长和次数，并显示同步时间。大数字便于扫读，时间戳说明数据的新鲜程度，避免把尚未同步误认为没有互动。'],['用故事吸引回看','“今日闪光”以蜗牛小屋等具体话题代替抽象指标，标题直接呈现孩子的表达。话题切换、数量与“查看瞬间”共同构成从概览进入详情的入口。'],['把观察和结论分开','兴趣线索显示“收集中”，说明需要更多对话才能观察反复出现的话题；互动记录保留原始对话入口，让家长可以继续查证。']]},
 {id:'detail',label:'02 / MOMENT',title:'一段小小的表达，值得被认真看见。',name:'内容页 · 瞬间详情',intro:'详情页把一次对话整理为可阅读的故事，同时保留判断依据。围绕“发生了什么—为什么保留—原话是什么—可以如何回应”组织内容，让家长理解孩子当时的想法。',points:[['先交代事件','“给小蜗牛盖一间挡雨的房子”以具体行为作为标题，时间段界定这次互动。摘要提取树叶屋顶、小石头压住等细节，减少阅读完整对话的负担。'],['明确 AI 的边界','“AI 整理”标识说明摘要的来源；“只记录本次表达，不判断能力或稳定兴趣”限制解读范围，避免把一次表达包装为成长评估。'],['让解释有依据','“为什么留下这一刻”之后紧接“互动依据”。角色、时间戳与原话建立可追溯的阅读结构，完整对话入口和转写误差提示帮助家长核对上下文。'],['把回看延伸为陪伴','底部给出“你想把小房子搭在哪里？”这样的开放式追问，让家长可以自然接续话题。反馈入口提供纠正整理结果的路径。']]},
 {id:'first',label:'03 / FIRST USE',title:'第一段陪伴，从一次轻松的聊天开始。',name:'首次使用 · 尚无互动',intro:'设备已经连接，但还没有可用于整理的真实互动。此时页面的任务是解释内容如何产生，并降低第一次使用的门槛。',points:[['告诉家长当前处境','“Fufu 已连接”先排除设备问题，主标题明确这是陪伴的起点，让空白页面具有清楚的原因。'],['建立真实内容预期','说明聊天之后，值得回看的表达才会出现，并强调“有真实互动依据时，才会生成瞬间”，避免用示例内容冒充孩子的记录。'],['给出足够轻的下一步','“让孩子聊聊今天发生的小事就好”把启动任务转为日常交流。返回首页提供自然出口，插画与留白让首次使用保持轻松。']]},
 {id:'generating',label:'04 / PROCESSING',title:'等待整理时，也能先读到真实对话。',name:'生成中 · 内容处理中',intro:'原话已经同步，摘要和推荐仍在生成。页面区分数据已到达与内容已整理两个阶段，让等待过程可理解。',points:[['说清楚正在等待什么','标题“这段互动正在整理”与“原话已同步，摘要和推荐还在生成”明确当前进度，避免用户把处理延迟理解为丢失记录。'],['保留可使用的信息','时间、角色和对话原文仍然可见，“先看完整对话”让家长不必等待全部整理结束，也能了解孩子说了什么。'],['让更新方式可预期','“整理完成后自动更新”说明后续行为。当前稿仍保留了“为什么留下这一刻”的解释，落地时应让它与摘要的生成状态保持一致，避免未完成时呈现确定结论。']]},
 {id:'empty',label:'05 / NO MOMENT',title:'没有精选瞬间，不等于没有陪伴。',name:'当天无内容 · 保留陪伴的价值',intro:'已同步记录中暂时没有适合整理成瞬间的内容，这与首次使用和设备断开是不同的情况。页面需要解释筛选结果，同时保留回看其他内容的路径。',points:[['明确时间与同步范围','日期、连接状态和同步时间共同界定当前结果，让家长理解“今天暂时没有”只对应此刻已同步的记录。'],['避免制造评价压力','“这并不代表今天没有陪伴”主动拆开精选内容与陪伴价值的关系，防止家长将空状态理解为孩子表现不足。'],['提供两条合理去向','“查看互动记录”用于回看真实交流，“查看其它日期”用于寻找已有瞬间；“新的对话同步后会继续整理”补充结果可能变化的条件。']]},
 {id:'offline',label:'06 / DEVICE',title:'先恢复连接，再继续记录陪伴。',name:'设备未连接 · 引导恢复',intro:'连接是同步记录的前提。这个状态把问题从内容层转回设备层，用明确动作帮助家长继续使用。',points:[['把原因放在操作之前','“尚未链接”和连接设备的说明共同解释为什么没有记录，避免用户反复刷新内容。设备插画提供直观的情境提示。'],['突出一个主要动作','蓝色“绑定设备”按钮承担主要引导，“返回首页”作为次级出口。按钮与说明在同一张卡片中，缩短从理解问题到采取行动的距离。'],['区分首次绑定与掉线','当前选中画面使用“绑定设备”，更符合尚未绑定的场景。如果已绑定设备只是离线，实际产品应提供“重新连接”及对应检查提示，保持状态与动作匹配。']]},
];
---
<BaseLayout title="哇布 Fufu｜陪伴玩具体验设计 · TOK" description="陪伴玩具的首页、瞬间内容页与四种关键状态设计，记录每个页面的信息层级、交互引导和设计逻辑。" keywords="陪伴玩具,哇布,Fufu,UI设计,状态设计">
 <main class="wabu-case">
  <header class="case-hero">
   <div class="hero-copy"><a class="back" href="/">← 返回作品集</a><p class="kicker">WABU / COMPANION EXPERIENCE</p><h1>让每一次陪伴，<br/>都有迹可循<span>。</span></h1><p class="lead">哇布 Fufu · 陪伴玩具的首页、内容页及状态设计</p><p class="hero-note">从日常互动到值得回看的瞬间，让家长看见孩子的表达，也找到继续陪伴的灵感。</p><a class="explore" href="#overview">探索设计逻辑 <span>↓</span></a></div>
   <div class="hero-art"><span class="art-orbit"></span><img src="/assets/projects/wabu/home.webp" alt="哇布首页完整设计" width="750" height="1944" fetchpriority="high"/><img src="/assets/projects/wabu/detail.webp" alt="瞬间详情设计" width="750" height="1944"/><span class="art-caption">LITTLE MOMENTS, MEANINGFUL CONNECTIONS</span></div>
  </header>
  <section id="overview" class="overview wrap"><p class="kicker">THE IDEA</p><h2>让家长看见表达，<br/>让设计保留温度。</h2><div class="overview-body"><p>这组界面连接实体陪伴玩具与家长端的日常回看：孩子与 Fufu 自然交流，家长通过首页了解陪伴概况，再进入瞬间详情阅读具体表达和互动依据。</p><p>设计的重心是建立清晰、可信的阅读路径。蓝白色调、大圆角卡片与柔软的角色形象延续玩具的亲近感；重要数据、原始对话和操作入口保持明确层级，让情绪表达与信息效率共同成立。</p><div class="scope"><span>02 个核心页面</span><span>04 种关键状态</span><span>移动端体验设计</span></div></div></section>
  <nav class="case-nav wrap" aria-label="项目章节">{screens.map((s,i)=><a href={`#${s.id}`}><span>0{i+1}</span>{s.name.split(' · ')[0]}</a>)}</nav>
  <section class="principles wrap"><div><b>01</b><h3>有温度</h3><p>角色、插画与日常语言，建立玩具和界面之间的情感连续性。</p></div><div><b>02</b><h3>有依据</h3><p>摘要可追溯到原话，明确区分 AI 整理与孩子的真实表达。</p></div><div><b>03</b><h3>有回应</h3><p>每种状态解释发生了什么，并给出符合当前情境的下一步。</p></div></section>
  {screens.map((screen,i)=><section id={screen.id} class:list={['screen-section',{'alternate':i%2===1}]}><div class="screen-inner wrap"><div class="screen-visual"><span class="visual-index">0{i+1}</span><a href={`/assets/projects/wabu/${screen.id}.webp`} target="_blank" rel="noopener" aria-label={`打开${screen.name}高清原图`}><img src={`/assets/projects/wabu/${screen.id}.webp`} alt={screen.name} width="750" height="1944" loading="lazy"/></a><p>{screen.name} <span>↗ 点击查看原图</span></p></div><div class="screen-copy"><p class="kicker">{screen.label}</p><h2>{screen.title}</h2><p class="intro">{screen.intro}</p><div class="logic-list">{screen.points.map(([title,body],index)=><article><span>0{index+1}</span><div><h3>{title}</h3><p>{body}</p></div></article>)}</div></div></div></section>)}
  <section class="closing wrap"><p class="kicker">DESIGN REFLECTION</p><h2>陪伴不是一个分数，<br/>而是一段可以接续的对话。</h2><p>从首页的轻量概览，到详情里的原话依据，再到空白、等待和未连接状态，这套设计用一致的视觉语言解释不同情境。让每个页面既传递信息，也帮助家长理解当下、采取下一步行动。</p><p class="footnote">本案例展示选定的六张界面设计；设计解读基于当前页面的信息与交互表达，不包含未经验证的用户研究或上线效果数据。</p><a href="/project">浏览更多项目 ↗</a></section>
 </main>
</BaseLayout>
<style>
 .wabu-case{--blue:#1269ef;--navy:#102743;--muted:#56718b;background:#f8fbff;color:var(--navy);font-family:inherit;overflow:hidden}.wrap{max-width:1200px;width:calc(100% - 96px);margin:auto}.case-hero{display:grid;grid-template-columns:1fr 1fr;min-height:850px;background:#e6f2ff;padding:72px max(48px,calc((100vw - 1200px)/2));gap:40px;align-items:center}.back{font-size:14px;color:var(--muted);display:inline-block;margin-bottom:72px}.kicker{font-size:11px;letter-spacing:.19em;color:var(--blue);font-weight:700;margin:0 0 24px}h1{font-size:clamp(40px,4.1vw,64px);line-height:1.22;letter-spacing:-.04em;margin:0 0 30px;font-weight:750}h1 span{color:var(--blue)}.lead{font-size:18px;line-height:1.8}.hero-note{max-width:390px;color:var(--muted);line-height:1.9;font-size:15px;margin:18px 0 32px}.explore{display:inline-flex;gap:60px;border-bottom:1px solid #aac9e9;padding:14px 0;color:var(--navy);font-size:14px}.hero-art{position:relative;display:flex;align-items:center;gap:22px;padding:30px 0 60px}.hero-art img{width:47%;height:auto;position:relative;border-radius:22px;box-shadow:0 24px 50px #2f659522;transform:rotate(-6deg)}.hero-art img+img{transform:rotate(7deg) translateY(48px)}.art-orbit{position:absolute;width:580px;height:580px;border:1px solid #b9d8f6;border-radius:50%;left:-30px}.art-caption{position:absolute;bottom:-25px;font-size:9px;letter-spacing:.18em;color:var(--muted)}.overview{display:grid;grid-template-columns:1fr 1fr;gap:24px 90px;padding:112px 0 70px}.overview>.kicker{grid-column:1/-1;margin:0}h2{font-size:clamp(30px,3vw,46px);line-height:1.35;letter-spacing:-.025em;font-weight:700;margin:0}.overview-body p,.closing>p:not(.kicker){font-size:16px;line-height:1.95;color:var(--muted);margin:0 0 18px}.scope{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.scope span{font-size:11px;border:1px solid #c6d8e9;border-radius:30px;padding:8px 12px}.case-nav{display:flex;flex-wrap:wrap;border-top:1px solid #cfdeec;border-bottom:1px solid #cfdeec;padding:24px 0;justify-content:space-between;gap:18px}.case-nav a{font-size:12px;color:var(--navy)}.case-nav span{color:#7299bf;margin-right:8px}.principles{display:grid;grid-template-columns:repeat(3,1fr);gap:60px;padding:64px 0 100px}.principles b{color:var(--blue);font-size:12px}.principles h3{font-size:23px;margin:16px 0}.principles p{font-size:14px;line-height:1.9;color:var(--muted)}.screen-section{padding:100px 0;background:#edf5fe;scroll-margin-top:30px}.screen-section.alternate{background:#f8fbff}.screen-inner{display:grid;grid-template-columns:1fr 1fr;gap:110px;align-items:center}.alternate .screen-visual{order:2}.screen-visual{position:relative;padding:36px 40px 20px;background:#dfedfb;border-radius:28px;text-align:center}.visual-index{position:absolute;left:24px;top:10px;font-size:86px;font-weight:700;color:#c3dcf4;line-height:1}.screen-visual img{position:relative;width:100%;max-width:300px;height:auto;border-radius:23px;box-shadow:0 16px 35px #3b6a9220;transition:transform .2s}.screen-visual a:hover img{transform:translateY(-4px)}.screen-visual>p{margin:22px 0 0;font-size:12px;color:var(--muted);display:flex;justify-content:space-between;gap:10px}.screen-visual>p span{font-size:10px}.intro{font-size:15px;line-height:1.95;color:var(--muted);margin:24px 0 28px}.logic-list article{display:flex;gap:18px;padding:20px 0;border-top:1px solid #cbddee}.logic-list article>span{font-size:11px;color:var(--blue);padding-top:4px}.logic-list h3{font-size:17px;font-weight:650;margin:0 0 10px}.logic-list p{font-size:14px;line-height:1.9;color:var(--muted);margin:0}.closing{padding:120px 0;max-width:850px;text-align:center}.closing h2{margin-bottom:30px}.closing .footnote{font-size:12px!important;margin-top:30px!important}.closing>a{display:inline-block;color:var(--blue);margin-top:30px;border-bottom:1px solid #adcdf3;padding-bottom:10px}a:focus-visible{outline:3px solid #1269ef;outline-offset:5px}@media(max-width:1000px){.screen-inner{gap:48px}.case-hero{min-height:650px}.hero-art{gap:12px}.back{margin-bottom:40px}.overview{gap:24px 40px}}@media(max-width:700px){.wrap{width:calc(100% - 40px)}.case-hero{grid-template-columns:1fr;padding:32px 24px 64px;gap:26px}.back{margin-bottom:38px}.hero-art{max-width:420px;margin:auto;padding:0 10px 50px}.art-orbit{width:320px;height:320px}.art-caption{bottom:0}.hero-art img{border-radius:15px}.overview{grid-template-columns:1fr;padding:64px 0 40px}.principles{gap:22px;padding:38px 0 56px}.principles h3{font-size:20px}.principles p{font-size:12px}.case-nav{justify-content:flex-start;gap:18px 22px}.screen-section{padding:56px 0}.screen-inner{grid-template-columns:1fr;gap:36px}.screen-visual,.alternate .screen-visual{order:2}.screen-copy{order:1}.screen-visual img{max-width:300px}.screen-visual{padding:30px 30px 20px}.closing{padding:70px 0}.closing h2{font-size:28px}}@media(prefers-reduced-motion:reduce){.screen-visual img{transition:none}}
</style>
