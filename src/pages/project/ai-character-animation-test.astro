---
import BaseLayout from '../../layouts/BaseLayout.astro';
const name = 'ai制作人物小动画测试';
const video = '/assets/projects/motion/ai-character-animation-test.mp4';
const poster = '/assets/projects/motion/ai-character-animation-test.png';
---
<BaseLayout title={`${name}｜TOK`} description="人物 IP 表情动画测试：身体弹性、卷毛回弹、五官跟随与手脚配合。">
  <main class="motion-work">
    <div class="motion-shell">
      <a class="back" href="/project">← 返回作品列表</a>
      <header>
        <p class="eyebrow">MOTION / 05</p>
        <h1>{name}</h1>
        <p class="intro">人物 IP 表情动画 · 身体弹性、五官跟随与手脚配合</p>
      </header>
      <figure class="video-frame">
        <video src={video} poster={poster} width="1600" height="1320" controls loop playsinline preload="metadata" aria-label={`播放 ${name}`}>
          浏览器暂不支持播放此视频。
        </video>
        <figcaption>12 种表情 · 点击播放，观看循环动画。<a href={video}>单独打开视频</a></figcaption>
      </figure>
    </div>
  </main>
</BaseLayout>
<style>
  .motion-work{min-height:80vh;background:#111316;color:#f5f5f1;padding:42px 0 100px}
  .motion-shell{width:min(1080px,calc(100% - 48px));margin:auto}
  .back{display:inline-block;color:#aeb4b9;font-size:13px;text-decoration:none;padding:8px 0}
  .back:hover,figcaption a:hover{color:#fff}
  .back:focus-visible,figcaption a:focus-visible,video:focus-visible{outline:2px solid #fff;outline-offset:4px}
  header{margin:74px 0 36px}.eyebrow{font-size:11px;letter-spacing:.18em;color:#9fa7ad;margin:0 0 16px}
  .motion-work h1{color:#fff;font-size:clamp(42px,6vw,80px);line-height:1.2;letter-spacing:-.05em;margin:0;font-weight:600;overflow-wrap:anywhere;text-wrap:balance}
  .intro{font-size:14px;line-height:1.8;color:#9fa7ad;margin:18px 0 0}
  .video-frame{margin:0}.video-frame video{display:block;width:100%;height:auto;max-height:min(72vh,760px);background:#fff;object-fit:contain;border:1px solid #35383c;border-radius:10px}
  figcaption{font-size:12px;line-height:1.8;color:#9fa7ad;margin-top:15px}figcaption a{color:inherit;margin-left:12px;text-underline-offset:3px}
  @media(max-width:640px){.motion-work{padding:22px 0 72px}.motion-shell{width:calc(100% - 32px)}header{margin:50px 0 25px}.video-frame video{max-height:70vh;border-radius:6px}}
</style>
